\ x86-64 assembler for the AT&T syntax FrancOS is written in. It reads a file from
\ the toolchain archive, expands includes and macros, and builds each section the
\ way GNU as does, so the bytes can be compared exactly: branches are sized the same
\ way, and a reference the linker must finish is left as zero.

\ JIT source must assign a variable before it reads one.
def as-declare 0 :as-o 0 :as-p 0 :as-ls 0 :as-to 0 :as-kl 0 :as-kp 0 :as-nkw 0 :as-kc 0 :as-ka 0 :as-kx 0 :ap-sp 0 :ap-ip 0 :ap-o 0 :ap-np 0 :ap-count 0 :ap-nm 0 :as-nsym 0 :as-sec 0 :as-base 0 :as-nj 0 :as-ev 0 :as-eb 0 :as-es 0 :as-ed 0 :as-sz 0 :as-nf 0 :as-tail 0 :as-now 0 :as-rf 0 :as-mode 0 :as-dsize 0 :as-rb 0 :as-pold 0 :as-fsec 0 :as-k 0 :as-raw 0 :as-old 0 :as-cur 0 :as-pnew 0 :as-co 0 :as-rawbase 0 :as-fb 0 :as-outbase ;

def as-src $2800000 ;
def as-temp $2C00000 ;
def as-raw-text $2E00000 ;
def as-raw-entry $3000000 ;
def as-ro $3100000 ;
def as-data $3200000 ;
def as-out-text $3300000 ;
def as-out-entry $3500000 ;
def as-hash $3600000 ;
def as-kwhash $3640000 ;
def as-kw $3650000 ;
def as-syms $3700000 ;
def as-frags $3800000 ;
def as-pre $3880000 ;
def as-fixes $3900000 ;
def as-class $3B00000 ;
def as-macros $3B10000 ;
def as-istack $3B20000 ;
def as-labels $3B21000 ;
def as-args $3B22000 ;
def as-bss-base $3C00000 ;

\ Little-endian fields.
def as-g3 :as-ga as-ga byte@ as-ga 1 + byte@ 8 shl + as-ga 2 + byte@ 16 shl + ;
def as-p3 :as-pv :as-pa as-pa as-pv 255 band ! as-pa 1 + as-pv 8 shr 255 band ! as-pa 2 + as-pv 16 shr 255 band ! ;
def as-g4 :as-gb as-gb as-g3 as-gb 3 + byte@ 16777216 * + :as-gv 2147483647 as-gv - if as-gv 4294967296 - exit then as-gv ;
def as-p4 :as-qv :as-qa as-qv 4294967296 % :as-qv as-qa as-qv 16777216 % as-p3 as-qa 3 + as-qv 16777216 / floor ! ;

\ Output.
def as-b :as-bv as-o as-bv ! as-o 1 + :as-o ;
def as-n :as-nn :as-nv begin as-nn neg while as-nv 256 % as-b as-nv 256 / floor :as-nv as-nn 1 - :as-nn repeat ;
def as-put-n :as-wn :as-wv :as-wa begin as-wn neg while as-wa as-wv 256 % ! as-wv 256 / floor :as-wv as-wa 1 + :as-wa as-wn 1 - :as-wn repeat ;

\ Tokens. A token's hash comes with it, for both lookup tables.
def as-skip begin as-p byte@ :as-c as-c 32 - if0 as-p 1 + :as-p else as-c 9 - if0 as-p 1 + :as-p else exit then then again ;
def as-rest begin as-p byte@ :as-c as-c if0 exit then as-c 10 - if0 exit then as-p 1 + :as-p again ;
def as-tok as-p :as-ts 0 :as-th begin as-p byte@ :as-c as-class as-c + byte@ ifnz as-th 31 * as-c + 1048575 band :as-th as-p 1 + :as-p else as-p as-ts - :as-tl exit then again ;
def as-show :as-sl begin as-sl byte@ :as-c as-c if0 exit then as-c 10 - if0 exit then as-c emit as-sl 1 + :as-sl again ;
def as-bad 1 :as-failed "AS-BAD-LINE " type as-ls as-show cr ;
def as-limit :as-lm 1 :as-failed "AS-TOO-MANY " type as-lm type cr ;
def as-same-text :as-tn :as-tb :as-ta begin as-tn neg while as-ta byte@ as-tb byte@ - ifnz 0 exit then as-ta 1 + :as-ta as-tb 1 + :as-tb as-tn 1 - :as-tn repeat 1 ;
def as-hex-value :as-hc as-hc 58 - if as-hc 48 - :as-d as-d if -1 exit then as-d exit then as-hc 97 - :as-d as-d if as-hc 65 - :as-d then as-d if -1 exit then 5 as-d - if -1 exit then as-d 10 + ;
def as-hex 0 :as-hn begin as-p as-hn + byte@ as-hex-value 1 + ifnz 1 else 0 then neg while as-hn 1 + :as-hn repeat 0 :as-v as-hn 16 - if0 as-p byte@ as-hex-value :as-d 7 as-d - if as-d 16 - :as-v as-p 1 + :as-p as-hn 1 - :as-hn then then begin as-hn neg while as-v 16 * as-p byte@ as-hex-value + :as-v as-p 1 + :as-p as-hn 1 - :as-hn repeat as-v ;
def as-dec-in 0 :as-v begin as-p byte@ 48 - :as-d as-d if as-v exit then 9 as-d - if as-v exit then as-v 10 * as-d + :as-v as-p 1 + :as-p again ;
def as-number as-p byte@ 48 - if0 as-p 1 + byte@ 120 - if0 as-p 2 + :as-p as-hex exit then then as-dec-in ;

\ Keyword table: mnemonics, registers, directives and macros. Record, 12 bytes:
\ name 3, length 1, class 1, a 1, b 1, size 1.
def as-kw-rec 12 * as-kw + ;
def as-kw-find as-th 4095 band :as-kb begin as-kwhash as-kb 3 * + as-g3 :as-ki as-ki if0 0 exit then as-ki as-kw-rec :as-kr as-kr 3 + byte@ as-tl - if0 as-kr as-g3 as-temp + as-ts as-tl as-same-text ifnz as-kr exit then then as-kb 1 + 4095 band :as-kb again ;
def as-kw-put :as-ksz :as-ksuf as-to :as-kn 0 :as-th 0 :as-ki begin as-ki as-kl - while as-kp as-ki + byte@ :as-c as-to as-c ! as-th 31 * as-c + 1048575 band :as-th as-to 1 + :as-to as-ki 1 + :as-ki repeat as-ksuf ifnz as-to as-ksuf ! as-th 31 * as-ksuf + 1048575 band :as-th as-to 1 + :as-to then as-nkw 1 + :as-nkw as-nkw as-kw-rec :as-kr as-kr as-kn as-temp - as-p3 as-kr 3 + as-to as-kn - ! as-kr 4 + as-kc ! as-kr 5 + as-ka ! as-kr 6 + as-kx ! as-kr 7 + as-ksz ! as-th 4095 band :as-kb begin as-kwhash as-kb 3 * + :as-kh as-kh as-g3 ifnz as-kb 1 + 4095 band :as-kb else as-kh as-nkw as-p3 exit then again ;
def as-kw-int as-skip as-number ;
def as-kw-line begin as-skip as-p byte@ :as-c as-c 35 - if0 as-rest then as-p byte@ 10 - if0 as-p 1 + :as-p 1 else 0 then neg while repeat ;
def as-kw-load :as-p begin as-kw-line as-p byte@ if0 exit then as-tok as-ts :as-kp as-tl :as-kl as-kw-int :as-kc as-kw-int :as-ka as-kw-int :as-kx as-kw-int :as-kz as-kz 9 - if0 0 0 as-kw-put 98 1 as-kw-put 119 2 as-kw-put 108 4 as-kw-put 113 8 as-kw-put else 0 as-kz as-kw-put then again ;

def as-class-range :as-ce :as-cb begin as-cb as-ce 1 + - while as-class as-cb + 1 ! as-cb 1 + :as-cb repeat ;
def as-tables 0 :as-i begin as-i 256 - while as-class as-i + 0 ! as-i 1 + :as-i repeat 48 57 as-class-range 65 90 as-class-range 97 122 as-class-range 46 46 as-class-range 95 95 as-class-range 0 :as-i begin as-i 12288 - while as-kwhash as-i + 0 ! as-i 1 + :as-i repeat 0 :as-nkw as-temp :as-to "compiler/toolchain/x86.table" tc-find tc-addr as-kw-load ;

\ Preprocessor: copies text to as-src without comments, expanding as it goes.
def ap-push :ap-a as-istack ap-sp 4 * + ap-ip as-p4 ap-sp 1 + :ap-sp ap-a :ap-ip ;
def ap-get begin ap-ip byte@ :ap-c ap-c ifnz ap-ip 1 + :ap-ip ap-c exit then ap-sp if0 0 exit then ap-sp 1 - :ap-sp as-istack ap-sp 4 * + as-g4 :ap-ip again ;
def ap-put :ap-x ap-o ap-x ! ap-o 1 + :ap-o ;
def ap-block begin ap-get :ap-c ap-c if0 exit then ap-c 42 - if0 ap-ip byte@ 47 - if0 ap-ip 1 + :ap-ip exit then then again ;
def ap-hash begin ap-ip byte@ :ap-c ap-c if0 exit then ap-c 10 - if0 exit then ap-ip 1 + :ap-ip again ;
def ap-string begin ap-get :ap-c ap-c if0 exit then ap-c ap-put ap-c 92 - if0 ap-get ap-put else ap-c 34 - if0 exit then then again ;
def ap-line ap-o :ap-start begin ap-get :ap-c ap-c if0 ap-o ap-start - if0 0 exit then 10 ap-put 1 exit then ap-c 10 - if0 10 ap-put 1 exit then ap-c 47 - if0 ap-ip byte@ 42 - if0 ap-ip 1 + :ap-ip ap-block else 47 ap-put then else ap-c 35 - if0 ap-hash else ap-c 34 - if0 34 ap-put ap-string else ap-c 39 - if0 39 ap-put ap-get ap-put ap-ip byte@ 39 - if0 ap-get ap-put then else ap-c ap-put then then then then again ;
\ Leaves ap-ip on the line that starts with the given word.
def ap-scan :ap-wn :ap-w begin ap-ip :ap-q begin ap-q byte@ :ap-c ap-c 32 - if0 1 else ap-c 9 - if0 1 else 0 then then neg while ap-q 1 + :ap-q repeat ap-q ap-w ap-wn as-same-text ifnz exit then begin ap-ip byte@ :ap-c ap-c if0 1 :as-failed "AS-UNTERMINATED" type cr exit then ap-ip 1 + :ap-ip ap-c 10 - if0 0 else 1 then neg while repeat again ;
def ap-next-line begin ap-ip byte@ :ap-c ap-c if0 exit then ap-ip 1 + :ap-ip ap-c 10 - if0 exit then again ;
def ap-digits :ap-dv 10000 :ap-dd begin ap-dd neg while as-to ap-dv ap-dd / floor 10 % 48 + ! as-to 1 + :as-to ap-dd 10 / floor :ap-dd repeat ;
def ap-entry 16 * as-args + ;
def ap-match :ap-ms 0 :ap-mi begin ap-mi ap-np - while ap-mi ap-entry :ap-e ap-e 4 + byte@ :ap-ml ap-ms ap-e as-g4 ap-ml as-same-text ifnz as-class ap-ms ap-ml + byte@ + byte@ if0 ap-e exit then then ap-mi 1 + :ap-mi repeat 0 ;
def ap-copy :ap-cn :ap-cp begin ap-cn neg while as-to ap-cp byte@ ! as-to 1 + :as-to ap-cp 1 + :ap-cp ap-cn 1 - :ap-cn repeat ;
def ap-subst :ap-se :ap-ss begin ap-ss ap-se - while ap-ss byte@ :ap-c ap-c 92 - if0 ap-ss 1 + byte@ 64 - if0 ap-count ap-digits ap-ss 2 + :ap-ss else ap-ss 1 + ap-match :ap-hit ap-hit ifnz ap-hit 8 + as-g4 ap-hit 12 + as-g3 ap-copy ap-ss 1 + ap-hit 4 + byte@ + :ap-ss else as-to 92 ! as-to 1 + :as-to ap-ss 1 + :ap-ss then then else as-to ap-c ! as-to 1 + :as-to ap-ss 1 + :ap-ss then repeat ;
def ap-name-copy :ap-nl :ap-ns as-to ap-ns ap-nl ap-copy ;
def ap-macro as-skip as-tok as-ts :as-kp as-tl :as-kl 45 :as-kc ap-nm :as-ka 0 :as-kx 0 0 as-kw-put as-macros ap-nm 64 * + :ap-m 0 :ap-mp begin as-skip as-p byte@ 44 - if0 as-p 1 + :as-p as-skip then as-tok as-tl ifnz ap-m 8 + ap-mp 8 * + as-ts as-tl ap-name-copy as-p4 ap-m 12 + ap-mp 8 * + as-tl ! ap-mp 1 + :ap-mp 1 else 0 then neg while repeat ap-m 7 + ap-mp ! ap-nm 1 + :ap-nm ap-ip :ap-body ".endm" 5 ap-scan ap-m ap-body as-p4 ap-m 4 + ap-ip ap-body - as-p3 ap-next-line ;
def ap-arg-end begin as-p byte@ :as-c as-c if0 exit then as-c 10 - if0 exit then as-c 44 - if0 exit then as-c 32 - if0 exit then as-p 1 + :as-p again ;
def ap-expand :ap-kr as-macros ap-kr 5 + byte@ 64 * + :ap-m ap-m 7 + byte@ :ap-np 0 :ap-mi begin ap-mi ap-np - while ap-mi ap-entry :ap-e ap-e ap-m 8 + ap-mi 8 * + as-g4 as-p4 ap-e 4 + ap-m 12 + ap-mi 8 * + byte@ ! as-skip as-p byte@ 44 - if0 as-p 1 + :as-p as-skip then as-p :ap-as ap-arg-end ap-e 8 + ap-as as-p4 ap-e 12 + as-p ap-as - as-p3 ap-mi 1 + :ap-mi repeat ap-count 1 + :ap-count as-to :ap-t ap-m as-g4 :ap-b ap-b ap-b ap-m 4 + as-g3 + ap-subst as-to 0 ! as-to 1 + :as-to ap-t ap-push ;
def ap-irp as-skip as-tok 1 :ap-np 0 ap-entry :ap-e ap-e as-ts as-tl ap-name-copy as-p4 ap-e 4 + as-tl ! ap-ip :ap-body ".endr" 5 ap-scan ap-ip :ap-bend ap-next-line as-to :ap-t begin as-skip as-p byte@ 44 - if0 as-p 1 + :as-p 1 else 0 then neg while as-skip as-p :ap-as ap-arg-end as-p ap-as - :ap-vl ap-vl ifnz 0 ap-entry :ap-e ap-e 8 + ap-as as-p4 ap-e 12 + ap-vl as-p3 ap-body ap-bend ap-subst then repeat as-to 0 ! as-to 1 + :as-to ap-t ap-push ;
def ap-ifc as-skip as-p :ap-as ap-arg-end as-p ap-as - :ap-vl as-p 1 + :as-p as-skip as-p :ap-bs ap-arg-end as-p ap-bs - ap-vl - if0 ap-as ap-bs ap-vl as-same-text else 0 then if0 ".endif" 6 ap-scan ap-next-line then ;
def ap-include as-skip as-p 1 + :as-p as-p :ap-as begin as-p byte@ 34 - ifnz as-p 1 + :as-p 1 else 0 then neg while repeat as-to :ap-t ap-as as-p ap-as - ap-copy as-to 0 ! as-to 1 + :as-to ap-t tc-find :ap-r ap-r if0 1 :as-failed "AS-NO-FILE " type ap-t type cr exit then ap-r tc-addr ap-push ;
def ap-directive :ap-kr ap-kr 4 + byte@ :ap-kc ap-kc 45 - if0 ap-kr ap-expand exit then ap-kc 50 - if0 ap-include exit then ap-kc 51 - if0 ap-macro exit then ap-kc 52 - if0 ap-irp exit then ap-kc 53 - if0 ap-ifc exit then ;
def ap-do ap-start :as-p as-skip as-p byte@ 10 - if0 ap-start :ap-o exit then as-tok as-tl if0 exit then as-kw-find :ap-kr ap-kr if0 exit then 44 ap-kr 4 + byte@ - if ap-start :ap-o ap-kr ap-directive then ;
def ap-run :ap-ip 0 :ap-sp as-src :ap-o 0 :ap-nm 0 :ap-count begin ap-line neg while ap-do repeat ap-o 0 ! ap-o as-src - :as-end-offset ;

\ Symbols. Record, 24 bytes: name offset 3, length 1, section 1, offset 3, fragment
\ count 3, flags 1, value 4. Sections: 1 text, 2 rodata, 3 data, 4 bss, 5 text.entry,
\ 6 absolute, 7 common. Flags: 1 global, 2 defined.
def as-rec 24 * as-syms + ;
def as-same :as-sr as-sr as-rec :as-sa as-sa 3 + byte@ as-tl - ifnz 0 exit then as-sa as-g3 as-src + as-ts as-tl as-same-text ;
def as-new as-nsym 32767 - if0 "symbols" as-limit 0 exit then as-nsym 1 + :as-nsym as-nsym as-rec :as-sa as-sa as-ts as-src - as-p3 as-sa 3 + as-tl ! as-sa 4 + 0 ! as-sa 11 + 0 ! as-nsym ;
def as-sym as-th 16383 band :as-bk begin as-hash as-bk 3 * + :as-ba as-ba as-g3 :as-si as-si if0 as-new :as-si as-ba as-si as-p3 as-si exit then as-si as-same ifnz as-si exit then as-bk 1 + 16383 band :as-bk again ;
def as-sec-base :as-sb as-sb 1 - if0 as-raw-text exit then as-sb 2 - if0 as-ro exit then as-sb 3 - if0 as-data exit then as-sb 5 - if0 as-raw-entry exit then as-bss-base ;
def as-define :as-ds as-ds as-rec :as-la as-la 11 + byte@ 2 band ifnz as-bad then as-la 4 + as-sec ! as-la 5 + as-o as-base - as-p3 as-la 8 + as-nj as-p3 as-la 11 + as-la 11 + byte@ 1 band 2 + ! ;
def as-flag-global :as-gs as-gs as-rec 11 + :as-gf as-gf as-gf byte@ 1 band if0 as-gf byte@ 1 + else as-gf byte@ then ! ;
def as-here-sym as-ls :as-ts 0 :as-tl as-new :as-hs as-hs as-define as-hs ;
\ Numeric labels are stored under a generated name.
def as-local-name :as-ln :as-ld as-to :as-ts as-to 1 ! as-to 1 + as-ld ! as-to 2 + as-ln as-p3 as-to 5 + :as-to 5 :as-tl 0 :as-th 0 :as-li begin as-li 5 - while as-th 31 * as-ts as-li + byte@ + 1048575 band :as-th as-li 1 + :as-li repeat ;
def as-label-count 3 * as-labels + as-g3 ;
def as-local-def :as-ld0 as-labels as-ld0 3 * + as-ld0 as-label-count 1 + as-p3 as-ld0 as-ld0 as-label-count as-local-name as-sym as-define ;

\ Expressions leave symbol as-es, subtracted symbol as-eb and constant as-ev.
def as-add-sym :as-sg :as-sy as-sy as-rec :as-ar as-ar 4 + byte@ 6 - if0 as-ev as-ar 12 + as-g4 as-sg * + :as-ev exit then as-sg if as-eb ifnz as-bad then as-sy :as-eb exit then as-es ifnz as-bad then as-sy :as-es ;
def as-digit? :as-dc as-dc 48 - if 0 exit then 57 as-dc - if 0 exit then 1 ;
def as-factor as-skip as-p byte@ :as-c as-c as-digit? ifnz as-number exit then as-c 39 - if0 as-p 1 + byte@ :as-v as-p 2 + :as-p as-p byte@ 39 - if0 as-p 1 + :as-p then as-v exit then as-tok as-sym as-rec 12 + as-g4 ;
def as-term :as-tg begin as-skip as-p byte@ :as-c as-c 45 - if0 as-p 1 + :as-p as-tg neg :as-tg 1 else as-c 40 - if0 as-p 1 + byte@ :as-c as-c 37 - ifnz as-c 44 - ifnz as-ed 1 + :as-ed as-p 1 + :as-p 1 else 0 then else 0 then else 0 then then neg while repeat as-p byte@ :as-c as-c 40 - if0 exit then as-c as-digit? ifnz as-number :as-tv as-p byte@ :as-c as-c 102 - if0 as-tv as-tv as-label-count 1 + as-local-name as-sym as-tg as-add-sym as-p 1 + :as-p exit then as-c 98 - if0 as-tv as-tv as-label-count as-local-name as-sym as-tg as-add-sym as-p 1 + :as-p exit then else as-c 39 - if0 as-factor :as-tv else as-tok as-tl 1 - if0 as-ts byte@ 46 - if0 as-here-sym as-tg as-add-sym exit then then as-tl if0 as-bad as-rest exit then as-sym :as-sy as-sy as-rec 4 + byte@ 6 - ifnz as-sy as-tg as-add-sym exit then as-sy as-rec 12 + as-g4 :as-tv then then begin as-skip as-p byte@ 42 - if0 1 else 0 then neg while as-p 1 + :as-p as-tv as-factor * :as-tv repeat as-ev as-tv as-tg * + :as-ev ;
def as-expr 0 :as-es 0 :as-eb 0 :as-ev 0 :as-ed 1 as-term begin as-skip as-p byte@ :as-c as-c 43 - if0 as-p 1 + :as-p 1 as-term 1 else as-c 45 - if0 as-p 1 + :as-p -1 as-term 1 else as-c 41 - if0 as-ed ifnz as-ed 1 - :as-ed as-p 1 + :as-p 1 else 0 then else 0 then then then neg while repeat ;

\ Operands. Kinds: 1 register, 2 immediate, 3 memory.
def as-reg-in as-p 1 + :as-p as-tok as-kw-find :as-kr as-kr if0 as-bad 0 exit then as-kr 4 + byte@ 1 - ifnz as-bad 0 exit then as-kr ;
def as-operand 0 :as-xy 0 :as-xu 0 :as-xv -1 :as-xb -1 :as-xi 1 :as-xsc 0 :as-xab 0 :as-xc as-skip as-p byte@ 42 - if0 as-p 1 + :as-p as-skip then as-p byte@ :as-c as-c 37 - if0 1 :as-xk as-reg-in :as-kr as-kr if0 exit then as-kr 5 + byte@ :as-xr as-kr 7 + byte@ :as-xs as-kr 6 + byte@ :as-xc as-xs 1 - if0 as-xc if0 3 as-xr - if as-xr 8 - if 1 :as-need40 then then then then exit then as-c 36 - if0 as-p 1 + :as-p as-expr as-es :as-xy as-eb :as-xu as-ev :as-xv 2 :as-xk exit then 3 :as-xk as-c 40 - ifnz as-expr as-es :as-xy as-eb :as-xu as-ev :as-xv then as-p byte@ 40 - if0 as-p 1 + :as-p as-p byte@ 37 - if0 as-reg-in :as-kr as-kr if0 exit then as-kr 5 + byte@ :as-xb as-kr 7 + byte@ :as-xab as-skip then as-p byte@ 44 - if0 as-p 1 + :as-p as-reg-in :as-kr as-kr if0 exit then as-kr 5 + byte@ :as-xi as-kr 7 + byte@ :as-xab as-p byte@ 44 - if0 as-p 1 + :as-p as-number :as-xsc then then as-p byte@ 41 - ifnz as-bad as-rest exit then as-p 1 + :as-p then ;
def as-save-a as-xk :oa-k as-xr :oa-r as-xs :oa-s as-xc :oa-c as-xb :oa-b as-xi :oa-i as-xsc :oa-sc as-xv :oa-v as-xy :oa-y as-xu :oa-u as-xab :oa-ab ;
def as-save-b as-xk :ob-k as-xr :ob-r as-xs :ob-s as-xc :ob-c as-xb :ob-b as-xi :ob-i as-xsc :ob-sc as-xv :ob-v as-xy :ob-y as-xu :ob-u as-xab :ob-ab ;
def as-save-c as-xk :oc-k as-xr :oc-r as-xs :oc-s as-xc :oc-c ;
def as-use-a oa-k :as-xk oa-r :as-xr oa-s :as-xs oa-c :as-xc oa-b :as-xb oa-i :as-xi oa-sc :as-xsc oa-v :as-xv oa-y :as-xy oa-u :as-xu oa-ab :as-xab ;
def as-use-b ob-k :as-xk ob-r :as-xr ob-s :as-xs ob-c :as-xc ob-b :as-xb ob-i :as-xi ob-sc :as-xsc ob-v :as-xv ob-y :as-xy ob-u :as-xu ob-ab :as-xab ;
def as-ops 0 :as-nops 0 :oa-k 0 :ob-k 0 :oc-k begin as-skip as-p byte@ :as-c as-c 10 - if0 0 else as-c if0 0 else 1 then then neg while as-operand as-nops 1 + :as-nops as-nops 1 - if0 as-save-a then as-nops 2 - if0 as-save-b then as-nops 3 - if0 as-save-c then as-skip as-p byte@ 44 - if0 as-p 1 + :as-p then repeat ;
\ With no suffix, the size comes from the last general register operand.
def as-size-ok as-sz ifnz exit then as-nops 1 - if0 oa-k 1 - if0 oa-s :as-sz then exit then ob-k 1 - if0 ob-c if0 ob-s :as-sz exit then then oa-k 1 - if0 oa-c if0 oa-s :as-sz then then ;

\ Fixups. Record, 32 bytes: offset 3, section 1, fragment count 3, size 1, pc-relative 1,
\ tail 1, symbol 3, subtracted symbol 3, addend 4.
def as-fix-rec 32 * as-fixes + ;
def as-fix-add :as-fp :as-fz :as-fv :as-fu :as-fy as-nf 65535 - if0 "fixups" as-limit exit then as-nf as-fix-rec :as-fa as-fa as-o as-base - as-p3 as-fa 3 + as-sec ! as-fa 4 + as-nj as-p3 as-fa 7 + as-fz ! as-fa 8 + as-fp ! as-fa 9 + as-tail ! as-fa 10 + as-fy as-p3 as-fa 13 + as-fu as-p3 as-fa 16 + as-fv as-p4 as-nf 1 + :as-nf 0 as-fz as-n ;
\ A value of n bytes, from an expression that may still need the linker.
def as-value :as-vn :as-vv :as-vu :as-vy as-vy as-vu + ifnz as-vy as-vu as-vv as-vn 0 as-fix-add else as-vv as-vn as-n then ;

\ Encoding. as-rf is the ModRM reg field; as-x* is the r/m operand.
def as-fit8 :as-f8 as-f8 128 + if 0 exit then 127 as-f8 - if 0 exit then 1 ;
def as-fit32 :as-f32 as-f32 2147483648 + if 0 exit then 2147483647 as-f32 - if 0 exit then 1 ;
