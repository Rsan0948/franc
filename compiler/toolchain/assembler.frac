def as-put :as-pb as-co as-pb ! as-co 1 + :as-co ;
def as-fill :as-fn begin as-fn neg while as-co as-fb ! as-co 1 + :as-co as-fn 1 - :as-fn repeat ;
def as-long-rel :as-rn as-js as-reach? ifnz as-co as-js as-final as-co as-rn + as-outbase - - as-rn as-put-n then as-co as-rn + :as-co ;
def as-zero-out :as-fn2 0 :as-fb as-fn2 as-fill ;
def as-emit-jump as-ja 7 + byte@ :as-m as-ja 6 + byte@ :as-k as-ja 3 + as-g3 :as-js as-ja 8 + byte@ if0 as-k 16 - if0 $EB as-put else $70 as-k + as-put then as-js as-final as-co 1 + as-outbase - - 256 % as-put else as-k 16 - if0 $E9 as-put else $0F as-put $80 as-k + as-put then as-m 16 - if0 2 else 4 then :as-rn2 as-rn2 as-zero-out as-co as-rn2 - :as-co as-rn2 as-long-rel then as-cs 2 + :as-cs ;
\ GNU as pads 16-bit code with these no-ops. Only 16-bit code aligns inside text here.
def as-nop3 $8D as-put $74 as-put 0 as-put ;
def as-nop4 $8D as-put $B4 as-put 0 as-put 0 as-put ;
def as-nop-tail $8D as-put $BD as-put 0 as-put 0 as-put ;
def as-nop-fill :as-nz as-nz 1 - if0 $90 as-put exit then as-nz 2 - if0 $89 as-put $F6 as-put exit then as-nz 3 - if0 as-nop3 exit then as-nz 4 - if0 as-nop4 exit then as-nz 5 - if0 $90 as-put as-nop4 exit then as-nz 6 - if0 $89 as-put $F6 as-put as-nop-tail exit then as-nz 7 - if0 as-nop3 as-nop-tail exit then ;
def as-emit-frag as-ja as-g3 as-copy as-ja 6 + byte@ :as-k 31 as-k - if as-k 32 - if0 as-ja 10 + as-g3 as-nop-fill else as-ja 10 + as-g3 as-zero-out then else as-emit-jump then ;
def as-emit-section :as-fsec as-fsec as-sec-base :as-rawbase as-fsec 5 - if0 as-out-entry else as-out-text then :as-outbase as-outbase :as-co 0 :as-cs 0 :as-i begin as-i as-nj - while as-frags as-i 16 * + :as-ja as-ja 9 + byte@ as-fsec - if0 as-emit-frag then as-i 1 + :as-i repeat as-saved as-fsec 4 * + as-g4 as-rawbase - as-copy as-co ;

def as-fix-pos :as-fa2 as-fa2 as-g3 as-fa2 3 + byte@ :as-rs as-rs 1 - if0 1 else as-rs 5 - if0 1 else 0 then then ifnz as-pold as-rs as-slot + as-fa2 4 + as-g3 3 * + as-g3 + then ;
def as-fix-out :as-rs as-rs 1 - if0 as-out-text exit then as-rs 5 - if0 as-out-entry exit then as-rs as-sec-base ;
def as-apply as-i as-fix-rec :as-fa as-fa 3 + byte@ :as-fsec as-fa as-fix-pos :as-fp2 as-fa 7 + byte@ :as-fz2 as-fa 10 + as-g3 :as-fy2 as-fa 13 + as-g3 :as-fu2 as-fa 16 + as-g4 :as-fv2 as-fsec as-fix-out as-fp2 + :as-fw as-fu2 ifnz as-fy2 as-rec 4 + byte@ as-fu2 as-rec 4 + byte@ - if0 as-fw as-fy2 as-final as-fu2 as-final - as-fv2 + as-fz2 as-put-n then exit then as-fy2 as-rec 4 + byte@ 6 - if0 as-fw as-fy2 as-rec 12 + as-g4 as-fv2 + as-fz2 as-put-n exit then as-fa 8 + byte@ ifnz as-fy2 as-reach? ifnz as-fy2 as-rec 11 + byte@ 1 band if0 as-fy2 as-final as-fv2 + as-fp2 as-fz2 + as-fa 9 + byte@ + - :as-fd as-fz2 1 - if0 as-fd as-fit8 if0 "AS-BAD-LINE loop target out of range" type cr 1 :as-failed then then as-fw as-fd as-fz2 as-put-n then then then ;
def as-fixups 0 :as-i begin as-i as-nf - while as-apply as-i 1 + :as-i repeat ;

def as-hex-digit :as-x as-x 10 - if as-x 48 + emit else as-x 87 + emit then ;
def as-dump :as-de :as-dp 0 :as-dc begin as-dp as-de - while as-dp byte@ :as-x2 as-x2 4 shr as-hex-digit as-x2 15 band as-hex-digit as-dc 1 + :as-dc as-dc 64 - if0 cr 0 :as-dc then as-dp 1 + :as-dp repeat cr ;
def as-clear as-tables 0 :as-failed 0 :as-i begin as-i 49152 - while as-hash as-i + 0 ! as-i 1 + :as-i repeat 0 :as-i begin as-i 30 - while as-labels as-i + 0 ! as-i 1 + :as-i repeat ;
\ Assembles one archive file. Returns 1 when every line was understood.
def as-assemble :as-file as-clear as-file tc-find :as-fr0 as-fr0 if0 "AS-NO-FILE " type as-file type cr 0 exit then as-fr0 tc-addr ap-run as-failed ifnz 0 exit then "AS-EXPANDED " type as-end-offset . as-pass as-failed ifnz 0 exit then "AS-PARSED " type as-nsym . as-nj . as-nf . as-relax "AS-RELAXED " type as-passes . 1 as-emit-section :as-text-end 5 as-emit-section :as-entry-end as-fixups as-failed if0 1 exit then 0 ;
def as-run :as-file0 "AS-BEGIN" type cr as-file0 as-assemble if0 "AS-FAILED" type cr "AS-END" type cr exit then "AS-TEXT" type cr as-out-text as-text-end as-dump "AS-ENTRY" type cr as-out-entry as-entry-end as-dump "AS-RO" type cr as-ro as-saved 8 + as-g4 as-dump "AS-DATA" type cr as-data as-saved 12 + as-g4 as-dump "AS-BSS" type cr as-saved 16 + as-g4 as-bss-base - . "AS-END" type cr ;
