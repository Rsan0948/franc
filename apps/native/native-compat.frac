\ Native FrancOS compatibility words for hosted Franc's libraries and apps.
\ Loaded by the native JIT; no C helpers, Linux calls or external compiler.
def inv 1 swap / ;
def ^ :pow-exponent :pow-base pow-exponent 0 - if 1 pow-base / :pow-base pow-exponent neg :pow-exponent then 1 :pow-result begin pow-exponent if0 pow-result exit then pow-result pow-base * :pow-result pow-exponent 1 - :pow-exponent again ;
def key-mode drop ;
def eval s2-eval ;
def ide-buffer $6b00000 ;
def home vc-home ;
\ Bind native app output to the existing Franc console in both boot modes.
\ These AOT console words retain their original runtime emit binding.
def native-emit emit ;
def emit ide-buffer 2096 + b@ ifnz native-emit else vc-put then ;
def native-type type ;
def type ide-buffer 2096 + b@ ifnz native-type else vc-type then ;
def cr 10 emit ;
\ Capture the original numeric formatter before rebinding dot. The
\ formatter scratch occupies bytes 2880..3007 of the existing IDE page,
\ below the CPL3 emitter at 3072..3327 and run output at 3360..3999.
def native-dot . ;
def . ide-buffer 2096 + b@ ifnz native-dot exit then ide-buffer 2880 + dup 127 + capture-start native-dot capture-stop dup if0 drop exit then 0 b! ide-buffer 2880 + vc-type ;
\ Deliberate scratch RAM reservations, outside framebuffer, bundle, and JIT.
\ Wave 4 native app-loader dependency: the restricted CPL3 emitter needs the
\ IDE scratch address before the full editor module is JIT-compiled. Both
\ definitions use exactly the same Franctxt-reserved physical page.
def calc-buffer $300000 ;
def history-buffer $310000 ;
def pixel@ :px-y :px-x px-y 0 - if 0 exit then px-x 0 - if 0 exit then px-x 320 - if0 0 exit then px-y 200 - if0 0 exit then $A0000 px-y 320 * + px-x + b@ ;
def line :ln-color :ln-y1 :ln-x1 :ln-y0 :ln-x0 ln-x1 ln-x0 - :ln-dx ln-y1 ln-y0 - :ln-dy ln-dx abs :ln-count ln-count ln-dy abs - if ln-dy abs :ln-count then ln-count if0 ln-x0 ln-y0 ln-color pixel exit then 0 :ln-i begin ln-i ln-count - 1 - while ln-x0 ln-dx ln-i * ln-count / + floor ln-y0 ln-dy ln-i * ln-count / + floor ln-color pixel ln-i 1 + :ln-i repeat ;
def fillrect :fr-color :fr-height :fr-width :fr-y :fr-x 0 :fr-row begin fr-row fr-height - while 0 :fr-col begin fr-col fr-width - while fr-x fr-col + fr-y fr-row + fr-color pixel fr-col 1 + :fr-col repeat fr-row 1 + :fr-row repeat ;
def palette :pl-blue :pl-green :pl-red :pl-index $3C8 pl-index io8! $3C9 pl-red io8! $3C9 pl-green io8! $3C9 pl-blue io8! ;
def copy :cp-dest :cp-source cp-source fs-source :cp-data cp-data if0 0 exit then cp-dest cp-data fs-save ;
def load fs-source :load-data load-data if0 0 exit then load-data :s2srci 0 :s2lines begin s2-read-line if0 s2lines exit then s2-line-buffer byte@ ifnz s2-line-buffer byte@ 92 - ifnz s2-line-buffer s2-compile if0 0 exit then s2lines 1 + :s2lines then then again ;
def launch :launch-name "main" s2-find :launch-code launch-name load if0 0 exit then "main" s2-find dup if0 drop 0 exit then dup launch-code - if0 drop 0 exit then s2-run 1 ;
def screenshot "SCREENSHOT EXPORT NOT AVAILABLE IN NATIVE VGA" type cr ;
def apps-init 6 :fp 0 :calc-ans 0 :calc-len 0 :calc-saved 0 :calc-prev ;
