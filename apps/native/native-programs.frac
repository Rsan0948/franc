\ Native runnable versions of the hosted examples and graphics demos.
\ Graphics demos draw directly to native VGA (no host PPM export).
def graphics-demo 20 fordland ;
def math-demo 3 fix-precision 1/3 fix 1/3 - . 355/113 cf . ;
def app-edit "notes.frac" edit-line ;
def sq dup * ;
def app-factorial dup 1 - if drop 1 else dup 1 - app-factorial * then ;
def app-demo 1/7 . -1/6 . 50 100 / . 5 sq . 5 app-factorial . ;
def app-font-demo crosshair "PICTURE READY | press a key for Home" type 10 emit key drop ;
def app-spiro-demo spiro-demo "PICTURE READY | press a key for Home" type 10 emit key drop ;
def app-ford-demo 20 fordland "PICTURE READY | press a key for Home" type 10 emit key drop ;
