1. The Hardware Primitives (Add to kernel.c)

Before the Franc libraries can run, the C Micro-Runtime must expose two tiny things: a bump allocator for the Bignum library, and raw bit-shifts for the Float library.

```c
// Add these to your C kernel
static uint8_t* g_heap = (uint8_t*)0x600000; 
static size_t g_heap_used = 0;

HELPER void h_alloc(void) {
    if (!need(1)) return;
    int64_t bytes = (--g_sp)->num;
    if (g_heap_used + bytes > 4*1024*1024) { g_sp[0] = (Rat){0,1}; g_sp++; return; }
    void* ptr = g_heap + g_heap_used;
    g_heap_used += (bytes + 7) & ~7;
    g_sp[0] = (Rat){(int64_t)ptr, 1}; g_sp++;
}

HELPER void h_lshift(void) {
    if (!need(2)) return;
    Rat shift = *--g_sp; Rat* a = &g_sp[-1];
    a->num <<= shift.num;
}

HELPER void h_rshift(void) {
    if (!need(2)) return;
    Rat shift = *--g_sp; Rat* a = &g_sp[-1];
    a->num >>= shift.num;
}
// In bootstrap(): add_word("alloc", h_alloc); add_word("<<", h_lshift); add_word(">>", h_rshift);
```

