5. The UEFI Bootloader (efi_main.c)

This is a standard C program compiled for 64-bit UEFI. It opens kernel.bin, loads it into memory, sets the screen resolution via GOP (Graphics Output Protocol), and jumps to the Franc kernel.

```c
#include <efi.h>
#include <efilib.h>

EFI_STATUS EFIAPI efi_main(EFI_HANDLE ImageHandle, EFI_SYSTEM_TABLE *SystemTable) {
    InitializeLib(ImageHandle, SystemTable);
    Print(L"FrancOS UEFI Bootloader\n");

    EFI_LOADED_IMAGE *LoadedImage;
    uefi_call_wrapper(BS->HandleProtocol, 3, ImageHandle, &LoadedImageProtocol, (void**)&LoadedImage);
    
    EFI_FILE_IO_INTERFACE *FileSystem;
    uefi_call_wrapper(BS->HandleProtocol, 3, LoadedImage->DeviceHandle, &FileSystemProtocol, (void**)&FileSystem);
    
    EFI_FILE_HANDLE Root;
    uefi_call_wrapper(FileSystem->OpenVolume, 2, FileSystem, &Root);

    EFI_FILE_HANDLE KernelFile;
    uefi_call_wrapper(Root->Open, 5, Root, &KernelFile, L"kernel.bin", EFI_FILE_MODE_READ, 0);

    // Allocate 4MB for the Franc Kernel at 0x10000
    EFI_PHYSICAL_ADDRESS KernelAddr = 0x10000;
    UINTN KernelSize = 4 * 1024 * 1024; 
    uefi_call_wrapper(BS->AllocatePages, 4, AllocateAddress, EfiLoaderData, KernelSize / 4096, &KernelAddr);

    // Read kernel.bin into memory
    UINTN ReadSize = KernelSize;
    uefi_call_wrapper(KernelFile->Read, 3, KernelFile, &ReadSize, (void*)KernelAddr);

    // Set up Graphics Output Protocol (GOP)
    EFI_GRAPHICS_OUTPUT_PROTOCOL *Gop;
    uefi_call_wrapper(BS->LocateProtocol, 3, &GraphicsOutputProtocol, NULL, (void**)&Gop);
    
    // Jump to the Franc kernel (which expects the framebuffer address)
    typedef void (*kernel_entry_t)(void*);
    kernel_entry_t kernel_entry = (kernel_entry_t)KernelAddr;
    kernel_entry((void*)Gop->Mode->FrameBufferBase);

    return EFI_SUCCESS;
}
```

