\ Native package code uses existing dormant app register ABI slots from
\ litetofrac/float/PCI/fibers because the 11-input Franc bootstrap seed pins
\ registry.frac. Full distinct package registers require a deliberate seed
\ regeneration during Wave 4 consolidation; none of these other modules are
\ concurrently active when package transactions run.
\ FrancOS U3: bounded *offline* package lifecycle.
\ The old pkg-install/pkg-load API remains explicitly TRUSTED development input
\ for legacy source tests; verified packages use separate guarded entrypoints.
\ Native FRANCFS1 allows 12 files, of which two are system identity docs.
\ Each of two supported package IDs (app, base) has two immutable banks
\ (source+canonical manifest), supporting verified update and rollback.
\ This is an intentionally bounded v1 package manager, not a general solver.
def pkg-install :pkg-source :pkg-name pkg-name pkg-source fs-save ;
def pkg-load :pkg-name pkg-name fs-source :pkg-loaded pkg-loaded if0 0 else pkg-loaded s2-source then ;
def pkg-list fs-files ;
def pkg-ready fs-ready? ;

\ The first 256 bytes of the native Franctxt reservation hold ft-get results.
\ 0x6d00200..0x6d00a00 holds our full independent 2048-byte manifest copy.
def pkg-manifest-buffer ft-value-buffer 512 + ;
def pkg-cache-manifest :lc-ch lc-ch if0 0 exit then 0 :lc-error begin lc-error 2047 - while lc-ch lc-error + byte@ :lc-len pkg-manifest-buffer lc-error + lc-len b! lc-len if0 pkg-manifest-buffer exit then lc-error 1 + :lc-error repeat pkg-manifest-buffer 2047 + 0 b! pkg-manifest-buffer ;
\ Test all required fields against the *actual raw SHA256*, not Franctxt
\ semantic SHA. This does not confer release trust to an unsigned manifest.
def pkg-verify :lc-p :lc-sp lc-sp ft-header? if0 0 exit then lc-sp "schema" ft-get ft-unquote "francos.package.v1" s2-eq if0 0 exit then lc-sp "package.file-count" ft-get ft-int 1 - ifnz 0 exit then lc-sp "package.file.0.bytes" ft-get ft-int lc-p fs-len - ifnz 0 exit then lc-sp "package.file.0.sha256" ft-get ft-unquote :lc-want lc-want if0 0 exit then lc-want fs-len 71 - ifnz 0 exit then lc-p dup fs-len pkg-sha256 :ld-ch ld-ch if0 0 exit then lc-want 7 + ld-ch s2-eq ;
\ Two fixed bank names per ID; no arbitrary device path can be supplied.
def pkg-names :fman-i :fman-p fman-p "app" s2-eq ifnz fman-i if0 "pkg-app0.frac" :fman-scale "pkg-app0.franctxt" :fman-v else "pkg-app1.frac" :fman-scale "pkg-app1.franctxt" :fman-v then 1 exit then fman-p "base" s2-eq ifnz fman-i if0 "pkg-base0.frac" :fman-scale "pkg-base0.franctxt" :fman-v else "pkg-base1.frac" :fman-scale "pkg-base1.franctxt" :fman-v then 1 exit then 0 ;
\ Return generation >=1 iff this bank has a coherent, SHA256-verified
\ source/manifest, matching package ID and exact bank filename.
def pkg-bank-valid :fman-i :fman-p fman-p fman-i pkg-names if0 -1 exit then fman-v fs-source pkg-cache-manifest :lc-sp lc-sp if0 -1 exit then fman-scale fs-source :lc-p lc-p if0 -1 exit then lc-sp lc-p pkg-verify if0 -1 exit then lc-sp "package.id" ft-get ft-unquote fman-p s2-eq if0 -1 exit then lc-sp "package.file.0.name" ft-get ft-unquote fman-scale s2-eq if0 -1 exit then lc-sp "package.generation" ft-get ft-int :ftr-class ftr-class 1 - if -1 else ftr-class then ;
\ Choose the newest coherent bank, even after a torn/premature source write.
\ A damaged latest version cannot suppress the earlier verified generation.
def pkg-select :fman-p fman-p 0 pkg-bank-valid :ftr-d fman-p 1 pkg-bank-valid :ftr-e ftr-d 0 - if ftr-e 0 - if 0 exit then 1 :ftr-p ftr-e :ftr-s 1 exit then ftr-e ftr-d - if 0 :ftr-p ftr-d :ftr-s else 1 :ftr-p ftr-e :ftr-s then 1 ;
\ Native package upload requires a *trusted offline staging manifest and
\ source* already on FRANCFS1, e.g. via the IDE or image installer. The
\ manifest must name the inactive fixed bank filename and use a strictly
\ newer generation, so the old verified bank remains rollbackable.
\ (staging-manifest staging-source package-id -- success).
def pkg-install-verified :pc-bus :pc-fn :pc-dev pc-bus pkg-select ifnz ftr-p if0 1 :pc-off else 0 :pc-off then ftr-s :ps-id else 0 :pc-off 0 :ps-id then pc-bus pc-off pkg-names if0 0 exit then fman-scale :ps-slot fman-v :fib-a 0 :fib-b pc-bus "app" s2-eq ifnz "base" pkg-select ifnz "base" ftr-p pkg-names drop fman-v fs-source :fib-n fib-n ifnz fib-n "package.version" ft-get ft-unquote s2-intern :fib-b then then then pc-dev fs-source pkg-cache-manifest :lc-sp lc-sp if0 0 exit then pc-fn fs-source :lc-p lc-p if0 0 exit then lc-sp lc-p pkg-verify if0 0 exit then lc-sp "package.id" ft-get ft-unquote pc-bus s2-eq if0 0 exit then lc-sp "package.file.0.name" ft-get ft-unquote ps-slot s2-eq if0 0 exit then lc-sp "package.generation" ft-get ft-int :ftr-class ftr-class ps-id - if0 0 exit then ftr-class ps-id - if 0 exit then lc-sp "package.dependency-count" ft-get ft-int :fib-i pc-bus "base" s2-eq ifnz fib-i ifnz 0 exit then else fib-i 1 - ifnz 0 exit then fib-b if0 0 exit then lc-sp "package.dependency.0.id" ft-get ft-unquote "base" s2-eq if0 0 exit then lc-sp "package.dependency.0.version" ft-get ft-unquote fib-b s2-eq if0 0 exit then then ps-slot lc-p fs-save if0 0 exit then fib-a lc-sp fs-save if0 0 exit then pc-bus pc-off pkg-bank-valid ftr-class - ifnz 0 else 1 then ;
\ Roll back only if the older alternate bank is still verified.
\ (package-id -- success) removes newer manifest before its data sectors.
def pkg-rollback :pc-bus pc-bus "base" s2-eq ifnz "app" pkg-select ifnz 0 exit then then pc-bus pkg-select if0 0 exit then ftr-p :pc-off pc-off if0 1 :fman-i else 0 :fman-i then pc-bus fman-i pkg-bank-valid 0 - if 0 exit then pc-bus pc-off pkg-names if0 0 exit then fman-v fs-delete if0 0 exit then fman-scale fs-delete drop 1 ;
\ Uninstall publishes no runnable manifest when complete. If a power
\ failure interrupts multi-sector removal, previous banks may reappear;
\ directory updates are not yet write-ahead journaled or sector-atomic.
def pkg-uninstall :pc-bus pc-bus "base" s2-eq ifnz "app" pkg-select ifnz 0 exit then then pc-bus 0 pkg-names if0 0 exit then fman-v fs-delete drop fman-scale fs-delete drop pc-bus 1 pkg-names if0 0 exit then fman-v fs-delete drop fman-scale fs-delete drop pc-bus pkg-select ifnz 0 else 1 then ;
\ Load only verified source, parse the restricted Franc CPL3 grammar,
\ admit exact audited opcodes, then run under private CR3 using Wave 3 F3.
\ (package-id slot -- success)
def pkg-stage-user :pcl-bus :pc-bus pc-bus pkg-select if0 0 exit then pc-bus ftr-p pkg-names if0 0 exit then fman-v fs-source pkg-cache-manifest :lc-sp lc-sp if0 0 exit then fman-scale fs-source :lc-p lc-p if0 0 exit then lc-sp lc-p pkg-verify if0 0 exit then lc-p user-compile :pcl-dev pcl-dev if0 0 exit then user-code-base pcl-dev pcl-bus user-code-stage ;
\ app=faulting task A, base=healthy task B; no privileged source JIT.
\ Before staging any code, verify the already-installed app's dependency
\ still pins exactly the currently selected base version.
def pkg-dependency-valid "app" pkg-select if0 0 exit then "app" ftr-p pkg-names if0 0 exit then fman-v fs-source pkg-cache-manifest :lc-sp lc-sp if0 0 exit then lc-sp "package.dependency.0.version" ft-get ft-unquote s2-intern :fib-b fib-b if0 0 exit then "base" pkg-select if0 0 exit then "base" ftr-p pkg-names if0 0 exit then fman-v fs-source pkg-cache-manifest :lc-sp lc-sp if0 0 exit then lc-sp "package.version" ft-get ft-unquote fib-b s2-eq ;
def pkg-run-pair pkg-dependency-valid if0 0 exit then "app" 1 pkg-stage-user if0 0 exit then "base" 2 pkg-stage-user if0 0 exit then user-compiled-probe ;
\ Show actual manifest version as well as bank generation; never describe
\ an invalid/corrupted bank as installed.
def pkg-show-one :pc-bus pc-bus vc-type pc-bus pkg-select if0 " not installed" vc-type vc-newline exit then pc-bus ftr-p pkg-names if0 " invalid identity" vc-type vc-newline exit then fman-v fs-source pkg-cache-manifest :lc-sp lc-sp if0 " missing manifest" vc-type vc-newline exit then lc-sp "package.version" ft-get ft-unquote :lc-want " version " vc-type lc-want ifnz lc-want vc-type else "?" vc-type then " | generation " vc-type ftr-s . ;
def pkg-show "base" pkg-show-one "app" pkg-show-one ;
\ Full UI is keyboard driven; source files/manifests are chosen explicitly.
def pkg-ui 0 vc-clear vc-home "FrancOS PACKAGES | SHA256 verified" vc-type vc-newline "l Status | i Install/update | b Rollback" vc-type vc-newline "u Uninstall | x Run app+base | Esc Home" vc-type vc-newline "Offline, fixed app/base bank slots" vc-type vc-newline begin "pkg> " vc-type dk-key :pkg-name pkg-name 27 - if0 vc-newline exit then pkg-name 108 - if0 pkg-show else pkg-name 105 - if0 "Manifest staging filename> " vc-type rl-read ifnz exit then repl-buffer s2-intern :pc-dev "Source staging filename> " vc-type rl-read ifnz exit then repl-buffer s2-intern :pc-fn "Package id (app/base)> " vc-type rl-read ifnz exit then pc-dev pc-fn repl-buffer pkg-install-verified ifnz "INSTALLED VERIFIED" vc-type vc-newline else "INSTALL REFUSED" vc-type vc-newline then else pkg-name 98 - if0 "Rollback app/base> " vc-type rl-read ifnz exit then repl-buffer pkg-rollback ifnz "ROLLED BACK" vc-type vc-newline else "NO VALID PREVIOUS BANK" vc-type vc-newline then else pkg-name 117 - if0 "Uninstall app/base> " vc-type rl-read ifnz exit then repl-buffer pkg-uninstall ifnz "UNINSTALLED" vc-type vc-newline else "UNINSTALL REFUSED" vc-type vc-newline then else pkg-name 120 - if0 pkg-run-pair . else "l i b u x Esc" vc-type vc-newline then then then then then again ;
