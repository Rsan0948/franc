\ Native multiline source-buffer IDE. Source is limited to 2047 bytes by FRANCFS1.
\ The UI uses the VGA text console; operations are callable from the REPL too.
\ Address 0x6b00000 is experimental identity-mapped RAM on 128 MiB QEMU.
def ide-buffer $6b00000 ;
def ide-reset 0 :ide-length 0 :ide-cursor ide-buffer 0 b! ide-buffer 2050 + 0 b! ide-buffer 2051 + 0 b! ide-buffer 2052 + 0 b! ide-buffer 2096 + 0 b! ide-buffer 2097 + 0 b! ide-buffer 2098 + 0 b! ide-buffer 3360 + 0 b! ;
def ide-start 0 :ide-kind ide-reset "project.frac" :ide-file ;
def ide-size ide-length ;
def ide-insert :ide-text :ide-at ide-at 0 - if 0 exit then ide-length ide-at - if 0 exit then ide-text fs-len :ide-n ide-n ide-length + 2048 - if0 0 exit then ide-n ide-length + 2048 - if 0 :ide-i else 0 exit then ide-buffer ide-length ide-n + + 0 b! ide-length 1 - :ide-i begin ide-at ide-i 1 + - while ide-buffer ide-i ide-n + + ide-buffer ide-i + b@ b! ide-i 1 - :ide-i repeat 0 :ide-i begin ide-i ide-n - while ide-buffer ide-at ide-i + + ide-text ide-i + b@ b! ide-i 1 + :ide-i repeat ide-length ide-n + :ide-length ide-at ide-n + :ide-cursor ide-buffer 2050 + 1 b! 1 ;
def ide-append :ide-text ide-length ide-text ide-insert ;
def ide-add-line :ide-text ide-length ide-text fs-len + 2047 - if ide-text ide-append if0 0 exit then ide-buffer ide-length + 10 b! ide-length 1 + :ide-length ide-buffer ide-length + 0 b! 1 else 0 then ;
def ide-delete :ide-n :ide-at ide-at 0 - if 0 exit then ide-n 0 - if 0 exit then ide-length ide-at ide-n + - if 0 exit then ide-at :ide-i begin ide-i ide-length ide-n - 1 + - while ide-buffer ide-i + ide-buffer ide-i ide-n + + b@ b! ide-i 1 + :ide-i repeat ide-length ide-n - :ide-length ide-at :ide-cursor ide-buffer 2050 + 1 b! 1 ;
def ide-name :ide-file ide-file ;
def ide-save ide-file if0 0 exit then ide-file ide-buffer fs-save :ide-n ide-n ifnz ide-buffer 2050 + 0 b! then ide-n ;
def ide-load :ide-filename ide-filename fs-source :ide-source ide-source if0 0 exit then ide-source fs-len :ide-n ide-n 2048 - if0 0 exit then ide-reset 0 :ide-i begin ide-i ide-n - while ide-buffer ide-i + ide-source ide-i + b@ b! ide-i 1 + :ide-i repeat ide-buffer ide-n + 0 b! ide-n :ide-length ide-n :ide-cursor ide-filename :ide-file 1 ;
def ide-compile ide-buffer s2-source ;
def ide-show 0 vc-clear vc-home "FrancOS native IDE | " vc-type ide-file vc-type vc-newline "----- source -----" vc-type vc-newline ide-buffer vc-type vc-newline "----- end -----" vc-type vc-newline ;
\ Wave 1 UX: cursor editing, a bounded wrapped viewport and file navigation.
\ Scratch bytes 2048-2049 are a one-character NUL string, 2050 is dirty,
\ and 2064-2088 hold a stable filename. All are inside the 4KiB IDE reservation.
def ide-set-name :ide-filename ide-filename fs-len :ide-n ide-n if0 0 exit then ide-n 24 - if0 0 exit then ide-n 24 - if 0 :ide-i else 0 exit then 0 :ide-i begin ide-i ide-n - while ide-buffer 2064 + ide-i + ide-filename ide-i + b@ b! ide-i 1 + :ide-i repeat ide-buffer 2064 + ide-n + 0 b! ide-buffer 2064 + :ide-file 1 ;
def ide-line-start :ide-at ide-at :ide-i begin ide-i if0 ide-i exit then ide-buffer ide-i 1 - + b@ 10 - if0 ide-i exit then ide-i 1 - :ide-i again ;
def ide-line-end :ide-at ide-at :ide-i begin ide-i ide-length - if0 ide-i exit then ide-buffer ide-i + b@ 10 - if0 ide-i exit then ide-i 1 + :ide-i again ;
def ide-left ide-cursor ifnz ide-cursor 1 - :ide-cursor then ;
def ide-right ide-cursor ide-length - if ide-cursor 1 + :ide-cursor then ;
def ide-up ide-cursor ide-line-start :ide-n ide-n if0 exit then ide-cursor ide-n - :ide-text ide-n 1 - ide-line-start :ide-at ide-at ide-text + :ide-i ide-n 1 - ide-i - if ide-n 1 - :ide-cursor else ide-i :ide-cursor then ;
def ide-down ide-cursor ide-line-start :ide-n ide-cursor ide-n - :ide-text ide-cursor ide-line-end :ide-at ide-at ide-length - if0 exit then ide-at 1 + :ide-n ide-n ide-line-end :ide-at ide-n ide-text + :ide-i ide-at ide-i - if ide-at :ide-cursor else ide-i :ide-cursor then ;
def ide-backspace ide-cursor ifnz ide-cursor 1 - 1 ide-delete drop then ;
def ide-type-char ide-buffer 2048 + swap b! ide-buffer 2049 + 0 b! ide-cursor ide-buffer 2048 + ide-insert if0 ide-buffer 2051 + 1 b! else ide-buffer 2051 + 0 b! then ;
\ Wave 2 editor semantics: line home/end and delete-forward never
\ change bytes outside the 2047-byte persisted source cap.
def ide-line-home ide-cursor ide-line-start :ide-cursor ;
def ide-line-last ide-cursor ide-line-end :ide-cursor ;
def ide-delete-next ide-cursor ide-length - if ide-cursor 1 ide-delete drop then ;
\ Run only a freshly redefined main. The Stage 2 compiler currently
\ prints generic error text, not line diagnostics; never run an old main.
\ Wave 2 U2: bounded line-by-line build. Stop at the first malformed line.
\ Stage2 s2-source historically discards compile failures; the IDE cannot.
\ The source slot remains limited to 2047 bytes, with 239-byte lines.
\ Scratch 2052 is the current-build entrypoint flag, never the full-buffer
\ status at 2051. No stale "main" may execute after a failed/new build.
def ide-lines-safe 0 :ide-at 0 :ide-text begin ide-at ide-length - if0 1 exit then ide-buffer ide-at + b@ 10 - if0 0 :ide-text else ide-text 1 + :ide-text ide-text 240 - if0 "LINE TOO LONG (239 MAX)" vc-type vc-newline 0 exit then then ide-at 1 + :ide-at again ;
def ide-main-line :ide-source 0 :ide-at begin ide-at 8 - while ide-source ide-at + byte@ "def main" ide-at + byte@ - ifnz 0 exit then ide-at 1 + :ide-at repeat ide-source 8 + byte@ 32 - if0 1 else 0 then ;
def ide-build ide-lines-safe if0 0 exit then ide-buffer 2052 + 0 b! ide-buffer :s2srci 0 :ide-i begin s2-read-line :ide-n ide-n if0 "COMPILE OK | lines " vc-type ide-i . 1 exit then s2-line-buffer byte@ ifnz s2-line-buffer byte@ 92 - ifnz s2-line-buffer ide-main-line ifnz ide-buffer 2052 + 1 b! then s2-line-buffer s2-compile :ide-at ide-at if0 "COMPILE FAILED | line " vc-type ide-i 1 + . "SOURCE: " vc-type s2-line-buffer vc-type vc-newline 0 exit then then then ide-i 1 + :ide-i again ;
def ide-run ide-build if0 exit then ide-buffer 2052 + b@ if0 "NO def main ENTRYPOINT" vc-type vc-newline exit then "main" s2-find :ide-at ide-at if0 "MAIN NOT COMPILED" vc-type vc-newline exit then "RUNNING main (trusted source)" vc-type vc-newline ide-at s2-run last-error :ide-at ide-at ifnz ide-at ui-error exit then "RUN COMPLETE" vc-type vc-newline ;
\ Scroll window begins on a real line boundary and displays at most 19 rows.
\ Wave 4 integrated user-execution path: editor source, persisted with
\ normal IDE Save/Open, is compiled *only* through the restricted Franc
\ CPL3 compiler. No privileged Stage 2 JIT call is used to execute it.
\ One deliberate user fault leaves the healthy companion runnable; a
\ replacement Franc program proves a fresh generation can relaunch.
def ide-run-user ide-buffer user-compile :ide-n ide-length :ide-cursor ide-n if0 "CPL3 accepts only def main N count fault/again ;" ui-error exit then user-code-base ide-n 1 user-code-stage if0 "User admission refused" ui-error exit then "def main 2 count again ;" user-compile :ide-n user-code-base ide-n 2 user-code-stage if0 "Peer admission refused" ui-error exit then irq-start drop ring3-probe drop user-compiled-a-kind 1 - if0 user-compiled-probe else user-compiled-relaunch then :ide-n ide-length :ide-cursor ide-n if0 "User launch failed" ui-error exit then "CPL3 user task / peer completed" ui-ok user-compiled-a-kind 1 - if0 "A fault isolated | B survived" ui-status "def main 3 count again ;" user-compile :ide-n user-code-base ide-n 1 user-code-stage if0 "Replacement admission refused" ui-error exit then user-compiled-relaunch ifnz "New CPL3 process generation" ui-ok else "Replacement launch failed" ui-error then then ;
\ Output pane uses bytes 3360..3999 of the existing 4KiB IDE page.
\ 2096 routes native app formatting into the outer capture; 2097/2098
\ record available/truncated output. Notes keeps its full editor height.
def ide-out-buffer ide-buffer 3360 + ;
def ide-output-clear ide-out-buffer 0 b! ide-buffer 2097 + 0 b! ide-buffer 2098 + 0 b! ;
def ide-capture :ide-out-action ide-cursor :ide-run-cursor ide-out-buffer 0 b! ide-buffer 2096 + 1 b! ide-out-buffer ide-out-buffer 639 + capture-start ide-out-action s2-run capture-stop :ide-out-end ide-buffer 2096 + 0 b! ide-out-end if0 ide-out-buffer 639 + :ide-out-end ide-buffer 2098 + 1 b! else ide-buffer 2098 + 0 b! then ide-out-end 0 b! ide-buffer 2097 + 1 b! ide-run-cursor :ide-cursor ;
def ide-console-body "console> " type repl-buffer type cr repl-buffer byte@ ifnz rl-eval then ;
def ide-console begin vc-row 23 - while vc-newline repeat "console> " vc-type rl-read ifnz exit then 'ide-console-body ide-capture ;
\ Walk backwards over display rows, so the reduced viewport still shows
\ the cursor after long lines and at the end of multiline source.
def ide-view-begin ide-cursor :ide-view-start 0 :ide-out-rows 0 :ide-out-cols begin ide-view-start if0 ide-view-start exit then ide-out-rows ide-kind ifnz 18 else 9 then - if0 ide-view-start exit then ide-view-start 1 - :ide-view-start ide-buffer ide-view-start + b@ 10 - if0 ide-out-rows 1 + :ide-out-rows 0 :ide-out-cols else ide-out-cols 1 + :ide-out-cols ide-out-cols 40 - if0 ide-out-rows 1 + :ide-out-rows 0 :ide-out-cols then then again ;
def ide-source-view ide-view-begin :ide-at begin vc-row ide-kind ifnz 23 else 15 then - if 0 :ide-i else exit then ide-at ide-length - if0 ide-at ide-cursor - if0 "|" vc-type then exit then ide-at ide-cursor - if0 "|" vc-type then ide-buffer ide-at + b@ vc-put ide-at 1 + :ide-at again ;
def ide-output-tail ide-out-end :ide-out-start 0 :ide-out-rows 0 :ide-out-cols begin ide-out-start ide-out-buffer - if0 exit then ide-out-rows 5 - if0 exit then ide-out-start 1 - :ide-out-start ide-out-start b@ 10 - if0 ide-out-rows 1 + :ide-out-rows 0 :ide-out-cols else ide-out-cols 1 + :ide-out-cols ide-out-cols 40 - if0 ide-out-rows 1 + :ide-out-rows 0 :ide-out-cols then then again ;
def ide-output-view begin vc-row 15 - while vc-newline repeat ui-rule ide-buffer 2098 + b@ ifnz "OUTPUT [truncated] | Ctrl-L clear" else "OUTPUT | Ctrl-T shell | Ctrl-L clear" then vc-type vc-newline ide-buffer 2097 + b@ if0 "No output yet. Ctrl-R runs main." vc-type exit then ide-output-tail ide-out-start :ide-out-at begin ide-out-at ide-out-end - if0 exit then vc-row 23 - if 0 :ide-i else exit then ide-out-at b@ vc-put ide-out-at 1 + :ide-out-at again ;
def ide-screen 0 vc-clear ui-chrome vc-home ide-kind ifnz "Notes | edit | " else "IDE | " then ui-title ide-file vc-type vc-newline ide-buffer 2050 + b@ ifnz "MODIFIED | " vc-type else "SAVED | " vc-type then "Tab save | Esc menu" vc-type ide-buffer 2051 + b@ ifnz " | BUFFER FULL" vc-type then vc-newline ide-kind ifnz "Arrows edit | Ctrl-S save" else "Ctrl-R trusted run | Ctrl-T shell" then vc-type vc-newline ui-rule ui-editor-rule ide-source-view ide-kind if0 ide-output-view then ;
def ide-edit ide-screen begin dk-key :ide-key ide-key 27 - if0 vc-newline exit else ide-key 17 - if0 vc-newline exit else ide-key 9 - if0 ide-save if0 "SAVE FAILED | text retained" ui-error key drop then else ide-key 19 - if0 ide-save if0 "SAVE FAILED | text retained" ui-error key drop then else ide-key 18 - if0 ide-kind if0 'ide-run ide-capture then else ide-key 20 - if0 ide-kind if0 ide-console then else ide-key 12 - if0 ide-kind if0 ide-output-clear then else ide-key 1 - if0 ide-line-home else ide-key 5 - if0 ide-line-last else ide-key 4 - if0 ide-delete-next else ide-key 1003 - if0 ide-left else ide-key 1004 - if0 ide-right else ide-key 1001 - if0 ide-up else ide-key 1002 - if0 ide-down else ide-key 8 - if0 ide-backspace else ide-key 127 - if0 ide-backspace else ide-key 10 - if0 10 ide-type-char else ide-key 32 - if0 ide-key ide-type-char else ide-key 32 - if else ide-key 127 - if ide-key ide-type-char then then then then then then then then then then then then then then then then then then then then ide-screen again ;
\ Visible FRANCFS1 directory in the VGA/serial IDE, bounded to 12 entries.
def ide-files fs-ready? if0 "DISK NOT READY" vc-type vc-newline exit then 129 ata-read-sector if0 "DIRECTORY READ ERROR" vc-type vc-newline exit then "Files | 12 slots maximum" vc-type vc-newline 0 :ide-i begin ide-i 12 - while ide-i 32 * sector-byte@ ifnz sector-buffer ide-i 32 * + vc-type vc-newline then ide-i 1 + :ide-i repeat ;
def ide-open-file "open file> " vc-type rl-read if0 repl-buffer ide-load ifnz repl-buffer ide-set-name drop "OPENED" vc-type vc-newline else "NOT FOUND / INVALID FILE" vc-type vc-newline then then ;
def ide-new-file "new file> " vc-type rl-read if0 repl-buffer ide-set-name ifnz ide-reset "NEW BUFFER" vc-type vc-newline else "INVALID NAME (1-23 BYTES)" vc-type vc-newline then then ;
def ide-help ui-rule "e Edit | n New | o Open | f Files" ui-help "s Save | c Build | r Run trusted" ui-help "y Run isolated CPL3 | q/Esc Home" ui-help "i Append | x Clear | v View" ui-help ;
def ide-menu-screen "Source IDE | command menu" ui-frame "File: " vc-type ide-file vc-type vc-newline "E opens editor | I appends a line" ui-help "Try: def main 42 . ; then R Run" ui-help ide-help ;
def ide-main ide-start ide-menu-screen begin "ide> " vc-type dk-key :ide-key ide-key 27 - if0 vc-newline exit else ide-key 113 - if0 vc-newline exit else ide-key 101 - if0 ide-edit ide-menu-screen else ide-key 102 - if0 ide-files else ide-key 111 - if0 ide-open-file else ide-key 110 - if0 ide-new-file else ide-key 105 - if0 "line> " vc-type rl-read if0 repl-buffer ide-add-line . then else ide-key 118 - if0 ide-show else ide-key 115 - if0 ide-save . else ide-key 108 - if0 ide-file ide-load . else ide-key 99 - if0 ide-build . else ide-key 114 - if0 ide-run else ide-key 121 - if0 ide-run-user else ide-key 120 - if0 ide-reset "cleared" vc-type vc-newline else ide-help then then then then then then then then then then then then then then again ;
