\ Native multiline source-buffer IDE. Source is limited to 2047 bytes by FRANCFS1.
\ The UI uses the VGA text console; operations are callable from the REPL too.
\ Address 0x6b00000 is experimental identity-mapped RAM on 128 MiB QEMU.
def ide-buffer $6b00000 ;
def ide-reset 0 :ide-length 0 :ide-cursor ide-buffer 0 b! ide-buffer 2050 + 0 b! ide-buffer 2051 + 0 b! ide-buffer 2052 + 0 b! ;
def ide-start ide-reset "project.frac" :ide-file ;
def ide-size ide-length ;
def ide-insert :ide-text :ide-at ide-at 0 - if 0 exit then ide-length ide-at - if 0 exit then ide-text fs-len :ide-n ide-n ide-length + 2048 - if0 0 exit then ide-n ide-length + 2048 - if 0 :ide-i else 0 exit then ide-buffer ide-length ide-n + + 0 b! ide-length 1 - :ide-i begin ide-at ide-i 1 + - while ide-buffer ide-i ide-n + + ide-buffer ide-i + b@ b! ide-i 1 - :ide-i repeat 0 :ide-i begin ide-i ide-n - while ide-buffer ide-at ide-i + + ide-text ide-i + b@ b! ide-i 1 + :ide-i repeat ide-length ide-n + :ide-length ide-at ide-n + :ide-cursor ide-buffer 2050 + 1 b! 1 ;
def ide-append :ide-text ide-length ide-text ide-insert ;
def ide-add-line :ide-text ide-length ide-text fs-len + 2047 - if ide-text ide-append if0 0 exit then ide-buffer ide-length + 10 b! ide-length 1 + :ide-length ide-buffer ide-length + 0 b! 1 else 0 then ;
def ide-delete :ide-n :ide-at ide-at 0 - if 0 exit then ide-n 0 - if 0 exit then ide-length ide-at ide-n + - if 0 exit then ide-at :ide-i begin ide-i ide-length ide-n - 1 + - while ide-buffer ide-i + ide-buffer ide-i ide-n + + b@ b! ide-i 1 + :ide-i repeat ide-length ide-n - :ide-length ide-at :ide-cursor ide-buffer 2050 + 1 b! 1 ;
def ide-name :ide-file ide-file ;
def ide-save ide-file if0 0 exit then ide-file ide-buffer fs-save :ide-n ide-n ifnz ide-buffer 2050 + 0 b! then ide-n ;
def ide-load :ide-filename ide-filename fs-source :ide-source ide-source if0 0 exit then ide-source fs-len :ide-n ide-n 2048 - if0 0 exit then ide-reset 0 :ide-i begin ide-i ide-n - while ide-buffer ide-i + ide-source ide-i + b@ b! ide-i 1 + :ide-i repeat ide-buffer ide-n + 0 b! ide-n :ide-length ide-n :ide-cursor ide-filename :ide-file 1 ;
def ide-compile ide-buffer s2-source ;
def ide-show 0 vc-clear vc-home "FrancOS native IDE | " vc-type ide-file vc-type vc-newline "----- source -----" vc-type vc-newline ide-buffer vc-type vc-newline "----- end -----" vc-type vc-newline ;
\ Wave 1 UX: cursor editing, a bounded wrapped viewport and file navigation.
\ Scratch bytes 2048-2049 are a one-character NUL string, 2050 is dirty,
\ and 2064-2088 hold a stable filename. All are inside the 4KiB IDE reservation.
def ide-set-name :ide-filename ide-filename fs-len :ide-n ide-n if0 0 exit then ide-n 24 - if0 0 exit then ide-n 24 - if 0 :ide-i else 0 exit then 0 :ide-i begin ide-i ide-n - while ide-buffer 2064 + ide-i + ide-filename ide-i + b@ b! ide-i 1 + :ide-i repeat ide-buffer 2064 + ide-n + 0 b! ide-buffer 2064 + :ide-file 1 ;
def ide-line-start :ide-at ide-at :ide-i begin ide-i if0 ide-i exit then ide-buffer ide-i 1 - + b@ 10 - if0 ide-i exit then ide-i 1 - :ide-i again ;
def ide-line-end :ide-at ide-at :ide-i begin ide-i ide-length - if0 ide-i exit then ide-buffer ide-i + b@ 10 - if0 ide-i exit then ide-i 1 + :ide-i again ;
def ide-left ide-cursor ifnz ide-cursor 1 - :ide-cursor then ;
def ide-right ide-cursor ide-length - if ide-cursor 1 + :ide-cursor then ;
def ide-up ide-cursor ide-line-start :ide-n ide-n if0 exit then ide-cursor ide-n - :ide-text ide-n 1 - ide-line-start :ide-at ide-at ide-text + :ide-i ide-n 1 - ide-i - if ide-n 1 - :ide-cursor else ide-i :ide-cursor then ;
def ide-down ide-cursor ide-line-start :ide-n ide-cursor ide-n - :ide-text ide-cursor ide-line-end :ide-at ide-at ide-length - if0 exit then ide-at 1 + :ide-n ide-n ide-line-end :ide-at ide-n ide-text + :ide-i ide-at ide-i - if ide-at :ide-cursor else ide-i :ide-cursor then ;
def ide-backspace ide-cursor ifnz ide-cursor 1 - 1 ide-delete drop then ;
def ide-type-char ide-buffer 2048 + swap b! ide-buffer 2049 + 0 b! ide-cursor ide-buffer 2048 + ide-insert if0 ide-buffer 2051 + 1 b! else ide-buffer 2051 + 0 b! then ;
\ Wave 2 editor semantics: line home/end and delete-forward never
\ change bytes outside the 2047-byte persisted source cap.
def ide-line-home ide-cursor ide-line-start :ide-cursor ;
def ide-line-last ide-cursor ide-line-end :ide-cursor ;
def ide-delete-next ide-cursor ide-length - if ide-cursor 1 ide-delete drop then ;
\ Run only a freshly redefined main. The Stage 2 compiler currently
\ prints generic error text, not line diagnostics; never run an old main.
\ Wave 2 U2: bounded line-by-line build. Stop at the first malformed line.
\ Stage2 s2-source historically discards compile failures; the IDE cannot.
\ The source slot remains limited to 2047 bytes, with 239-byte lines.
\ Scratch 2052 is the current-build entrypoint flag, never the full-buffer
\ status at 2051. No stale "main" may execute after a failed/new build.
def ide-lines-safe 0 :ide-index 0 :ide-width begin ide-index ide-length - if0 1 exit then ide-buffer ide-index + b@ 10 - if0 0 :ide-width else ide-width 1 + :ide-width ide-width 240 - if0 "LINE TOO LONG (239 MAX)" vc-type vc-newline 0 exit then then ide-index 1 + :ide-index again ;
def ide-main-line :ide-source 0 :ide-index begin ide-index 8 - while ide-source ide-index + byte@ "def main" ide-index + byte@ - ifnz 0 exit then ide-index 1 + :ide-index repeat ide-source 8 + byte@ 32 - if0 1 else 0 then ;
def ide-build ide-lines-safe if0 0 exit then ide-buffer 2052 + 0 b! ide-buffer :s2srci 0 :ide-line begin s2-read-line :ide-n ide-n if0 "COMPILE OK | lines " vc-type ide-line . 1 exit then s2-line-buffer byte@ ifnz s2-line-buffer byte@ 92 - ifnz s2-line-buffer ide-main-line ifnz ide-buffer 2052 + 1 b! then s2-line-buffer s2-compile :ide-code ide-code if0 "COMPILE FAILED | line " vc-type ide-line 1 + . "SOURCE: " vc-type s2-line-buffer vc-type vc-newline 0 exit then then then ide-line 1 + :ide-line again ;
def ide-run ide-build if0 exit then ide-buffer 2052 + b@ if0 "NO def main ENTRYPOINT" vc-type vc-newline exit then "main" s2-find :ide-code ide-code if0 "MAIN NOT COMPILED" vc-type vc-newline exit then "RUNNING main (trusted source)" vc-type vc-newline ide-code s2-run "RUN COMPLETE" vc-type vc-newline ;
\ Scroll window begins on a real line boundary and displays at most 19 rows.
def ide-screen 0 vc-clear vc-home "FrancOS IDE | " vc-type ide-file vc-type vc-newline ide-buffer 2050 + b@ ifnz "MODIFIED | " vc-type else "SAVED | " vc-type then "Tab save | Ctrl-R run | Esc back" vc-type ide-buffer 2051 + b@ ifnz " | BUFFER FULL" vc-type then vc-newline "Arrows move | Enter line | Backspace" vc-type vc-newline "---------------------------------------" vc-type vc-newline ide-cursor 300 - if 0 else ide-cursor 300 - ide-line-start then :ide-at begin ide-at ide-length - if0 "|" vc-type exit then vc-row 23 - if 0 :ide-i else exit then ide-at ide-cursor - if0 "|" vc-type then ide-buffer ide-at + b@ vc-put ide-at 1 + :ide-at again ;
def ide-edit ide-screen begin dk-key :ide-key ide-key 27 - if0 vc-newline exit else ide-key 17 - if0 vc-newline exit else ide-key 9 - if0 ide-save if0 "SAVE FAILED" vc-type vc-newline then else ide-key 19 - if0 ide-save if0 "SAVE FAILED" vc-type vc-newline then else ide-key 18 - if0 vc-newline ide-run exit else ide-key 1 - if0 ide-line-home else ide-key 5 - if0 ide-line-last else ide-key 4 - if0 ide-delete-next else ide-key 1003 - if0 ide-left else ide-key 1004 - if0 ide-right else ide-key 1001 - if0 ide-up else ide-key 1002 - if0 ide-down else ide-key 8 - if0 ide-backspace else ide-key 127 - if0 ide-backspace else ide-key 10 - if0 10 ide-type-char else ide-key 32 - if0 ide-key ide-type-char else ide-key 32 - if else ide-key 127 - if ide-key ide-type-char then then then then then then then then then then then then then then then then then then ide-screen again ;
\ Visible FRANCFS1 directory in the VGA/serial IDE, bounded to 12 entries.
def ide-files fs-ready? if0 "DISK NOT READY" vc-type vc-newline exit then 129 ata-read-sector if0 "DIRECTORY READ ERROR" vc-type vc-newline exit then "Files | 12 slots maximum" vc-type vc-newline 0 :ide-i begin ide-i 12 - while ide-i 32 * sector-byte@ ifnz sector-buffer ide-i 32 * + vc-type vc-newline then ide-i 1 + :ide-i repeat ;
def ide-open-file "open file> " vc-type rl-read if0 repl-buffer ide-load ifnz repl-buffer ide-set-name drop "OPENED" vc-type vc-newline else "NOT FOUND / INVALID FILE" vc-type vc-newline then then ;
def ide-new-file "new file> " vc-type rl-read if0 repl-buffer ide-set-name ifnz ide-reset "NEW BUFFER" vc-type vc-newline else "INVALID NAME (1-23 BYTES)" vc-type vc-newline then then ;
def ide-help "e Edit | n New | o Open | f Files | v View" vc-type vc-newline "s Save | c Build | r Run | q Home" vc-type vc-newline "i Append | x Clear | Tab Save | Ctrl-R Run" vc-type vc-newline ;
def ide-main ide-start ide-help begin "ide> " vc-type dk-key :ide-key ide-key 113 - if0 vc-newline exit else ide-key 101 - if0 ide-edit else ide-key 102 - if0 ide-files else ide-key 111 - if0 ide-open-file else ide-key 110 - if0 ide-new-file else ide-key 105 - if0 "line> " vc-type rl-read if0 repl-buffer ide-add-line . then else ide-key 118 - if0 ide-show else ide-key 115 - if0 ide-save . else ide-key 108 - if0 ide-file ide-load . else ide-key 99 - if0 ide-build . else ide-key 114 - if0 ide-run else ide-key 120 - if0 ide-reset "cleared" vc-type vc-newline else ide-help then then then then then then then then then then then then again ;
