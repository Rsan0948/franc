\ Stage 3 Franc-owned serial and PS/2 keyboard input drivers.
\ The C/assembly substrate exposes io8@, io8!, band and hardware?.
\ Event contract: printable ASCII, Enter=10, Backspace=8, Esc=27;
\ arrows: Up=1001 Down=1002 Left=1003 Right=1004, -1 means no event.
\ Hosted Linux path uses host-key for terminal's line discipline and ANSI arrows.
0 :dk-shift
0 :dk-extended

\ Scan-set-1 printable keys. Font and shell policies are not hardcoded in C.
def dk-map :dk-code dk-code 2 - if0 49 exit then dk-code 2 - if 0 exit then dk-code 14 - if dk-shift if0 "1234567890-=" else "!@#$%^&*()_+" then dk-code 2 - + byte@ exit then dk-code 14 - if0 8 exit then dk-code 15 - if0 9 exit then dk-code 16 - if 0 exit then dk-code 28 - if dk-shift if0 "qwertyuiop[]" else "QWERTYUIOP{}" then dk-code 16 - + byte@ exit then dk-code 28 - if0 10 exit then dk-code 30 - if 0 exit then dk-code 39 - if dk-shift if0 "asdfghjkl" else "ASDFGHJKL" then dk-code 30 - + byte@ exit then dk-code 39 - if0 dk-shift if0 59 else 58 then exit then dk-code 40 - if0 dk-shift if0 39 else 34 then exit then dk-code 41 - if0 dk-shift if0 96 else 126 then exit then dk-code 43 - if0 dk-shift if0 92 else 124 then exit then dk-code 44 - if 0 exit then dk-code 54 - if dk-shift if0 "zxcvbnm,./" else "ZXCVBNM<>?" then dk-code 44 - + byte@ exit then dk-code 57 - if0 32 exit then 0 ;
\ Poll one PS/2 controller byte, maintaining Shift and E0-prefix state.
def dk-scancode :dk-scan dk-scan 224 - if0 1 :dk-extended -1 exit then dk-scan 42 - if0 1 :dk-shift -1 exit then dk-scan 54 - if0 1 :dk-shift -1 exit then dk-scan 170 - if0 0 :dk-shift -1 exit then dk-scan 182 - if0 0 :dk-shift -1 exit then dk-scan 128 band ifnz 0 :dk-extended -1 exit then dk-extended ifnz 0 :dk-extended dk-scan 72 - if0 1001 exit then dk-scan 80 - if0 1002 exit then dk-scan 75 - if0 1003 exit then dk-scan 77 - if0 1004 exit then -1 exit then dk-scan dk-map :dk-ascii dk-ascii if0 -1 else dk-ascii then ;
\ Poll one scan set 1 code from controller; decode is testable in the host.
def dk-ps2-poll $64 io8@ 1 band if0 -1 exit then $60 io8@ dk-scancode ;
\ COM1 at 0x3f8; status bit 0 reports a received byte.
def dk-poll hardware? if0 -1 exit then $3FD io8@ 1 band ifnz $3F8 io8@ :dk-char dk-char 13 - if0 10 else dk-char then exit then dk-ps2-poll ;
\ Franc owns polling/blocking input; host-key is the host-only adapter.
def dk-key hardware? if0 host-key exit then begin dk-poll :dk-event dk-event 1 + ifnz dk-event exit then again ;
\ Replace the core dictionary word; later-compiled applications use Franc's driver.
def key dk-key ;
