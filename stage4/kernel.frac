\ AOT kernel proof: source is Franc; every runtime helper is assembly, not C.
\ The first standalone boot uses the existing Stage 1 BIOS loader.
def banner "FrancOS AOT | 64-bit | no C runtime" type cr ;
def add-test 1/3 1/6 + . ;
def square dup * ;
def branch-test 0 if0 "BRANCH OK" type cr else "BRANCH FAILED" type cr then ;
def loop-test 0 :count begin count 3 - while count 1 + :count repeat count . ;
def draw-demo 0 clearfb 10 20 14 pixel 11 20 15 pixel ;
def boot banner add-test 5 square . branch-test loop-test draw-demo "AOT BOOT OK" type cr ;
