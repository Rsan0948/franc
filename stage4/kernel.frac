\ AOT kernel proof: source is Franc; every runtime helper is assembly, not C.
\ The first standalone boot uses the existing Stage 1 BIOS loader.
def banner "FrancOS AOT | 64-bit | no C runtime" type cr ;
def add-test 1/3 1/6 + . ;
def square dup * ;
def branch-test 0 if0 "BRANCH OK" type cr else "BRANCH FAILED" type cr then ;
def loop-test 0 :count begin count 3 - while count 1 + :count repeat count . ;
def draw-demo 0 clearfb 10 20 14 pixel 11 20 15 pixel ;
def hardware? 1 ;
\ ATA driver below is stage3/ata.frac, compiled by the C-free AOT target.
\ Host-only fallbacks are never called by this standalone hardware kernel.
def disk-ready? 0 ;
def disk-format 0 ;
def host-save drop drop 0 ;
def host-source drop 0 ;
def host-files 0 drop ;
def host-key 0 ;
def store-check "proof.frac" "def saved 77 ;" fs-save . "proof.frac" fs-source :sc-ptr sc-ptr if0 "STORAGE LOAD FAILED" type cr else sc-ptr type cr "STORAGE OK" type cr then ;
def ata-check 128 ata-read-sector if0 "ATA READ FAILED" type cr exit then 0 sector-byte@ . 0 42 sector-byte! 190 ata-write-sector . 0 0 sector-byte! 190 ata-read-sector . 0 sector-byte@ . "ATA WRITE READBACK DONE" type cr ;
\ Wave 1: Home is the default visible surface even before JIT apps load.
\ The 320x200 BIOS VGA framebuffer provides 40x25 8x8 text cells; all
\ interactions retain serial output so headless QEMU and recovery work.
def home-item :home-caption :home-number home-selected home-number - if0 "> " vc-type else "  " vc-type then home-caption vc-type vc-newline ;
def home-draw 0 vc-clear vc-home "FrancOS HOME | single user" vc-type vc-newline "Up/Down select | Enter launch" vc-type vc-newline 1 "1  Calculator" home-item 2 "2  Notes" home-item 3 "3  Stern-Brocot" home-item 4 "4  Crosshair" home-item 5 "5  Ford circles" home-item 6 "6  Spirograph" home-item 7 "7  Math" home-item 8 "8  Demo" home-item 9 "9  Source IDE" home-item "---------------------------------------" vc-type vc-newline "z Files   m Packages   r Franc REPL" vc-type vc-newline "u Home    l Load apps  h Help" vc-type vc-newline "Esc exit   |  BIOS VGA / serial" vc-type vc-newline ;
def home-next home-selected 9 - if0 1 :home-selected else home-selected 1 + :home-selected then ;
def home-prev home-selected 1 - if0 9 :home-selected else home-selected 1 - :home-selected then ;
def home-app :home-app-key apps-loaded if0 apps-load then apps-loaded if0 "APPS UNAVAILABLE" vc-type vc-newline exit then home-app-key apps-menu ;
\ Flat FRANCFS1 directory with explicit errors, no hidden REPL verbs.
def home-file-list 0 vc-clear vc-home "FrancOS FILES | 12 slots x 2047B" vc-type vc-newline "o Open  n New  r Rename  d Delete" vc-type vc-newline "i IDE   Esc Back" vc-type vc-newline fs-ready? if0 "DISK NOT READY" vc-type vc-newline exit then 129 ata-read-sector if0 "DIRECTORY READ ERROR" vc-type vc-newline exit then 0 :home-file-i begin home-file-i 12 - while home-file-i 32 * sector-byte@ ifnz sector-buffer home-file-i 32 * + vc-type vc-newline then home-file-i 1 + :home-file-i repeat ;
def home-file-open "Open name> " vc-type rl-read if0 repl-buffer fs-source :home-fileptr home-fileptr if0 "FILE NOT FOUND" vc-type vc-newline else "----- FILE -----" vc-type vc-newline home-fileptr vc-type vc-newline "----- END -----" vc-type vc-newline then then ;
def home-file-new "New filename> " vc-type rl-read ifnz exit then repl-buffer s2-intern :home-filename "Source line> " vc-type rl-read ifnz exit then home-filename repl-buffer fs-save ifnz "CREATED" vc-type vc-newline else "CREATE FAILED (capacity/name/disk)" vc-type vc-newline then ;
def home-file-rename "Rename old> " vc-type rl-read ifnz exit then repl-buffer s2-intern :home-oldname "Rename new> " vc-type rl-read ifnz exit then home-oldname repl-buffer fs-rename ifnz "RENAMED" vc-type vc-newline else "RENAME FAILED (duplicate/invalid)" vc-type vc-newline then ;
def home-file-delete "Delete name> " vc-type rl-read ifnz exit then repl-buffer fs-delete ifnz "DELETED" vc-type vc-newline else "DELETE FAILED" vc-type vc-newline then ;
def home-files home-file-list begin "files> " vc-type dk-key :home-file-key home-file-key 27 - if0 vc-newline exit then home-file-key 111 - if0 home-file-open else home-file-key 110 - if0 home-file-new else home-file-key 114 - if0 home-file-rename else home-file-key 100 - if0 home-file-delete else home-file-key 105 - if0 57 home-app else "o n r d i / Esc" vc-type vc-newline then then then then then home-file-list again ;
def home-packages apps-loaded if0 apps-load then apps-loaded if0 "PACKAGES UNAVAILABLE" vc-type vc-newline exit then "pkg-ui" apps-run ;
\ Native keyboard loop: Franc owns the serial/PS2 input semantics and menu.
def console-help "FrancOS home: 1..9 apps, arrows+Enter, z files, m packages, u home, l load apps, r repl, h help, Esc exit. Diagnostics: p rational s storage g graphics b selfhost a aot c compile d control e strings f bundle k kernel." vc-type vc-newline ;
def console-main "FRANC INTERACTIVE READY" vc-type vc-newline 1 :home-selected home-draw begin "Franc> " vc-type dk-key :cc-key cc-key 27 - if0 "EXIT CONSOLE" vc-type vc-newline exit then cc-key 1001 - if0 home-prev home-draw else cc-key 1002 - if0 home-next home-draw else cc-key 10 - if0 home-selected 48 + home-app home-draw else cc-key 117 - if0 home-draw else cc-key 122 - if0 home-files home-draw else cc-key 109 - if0 home-packages home-draw else cc-key 107 - if0 bundle-kernel else cc-key 102 - if0 bundle-demo else cc-key 101 - if0 aot-string-reg-demo else cc-key 100 - if0 aot-control-demo else cc-key 99 - if0 aot-program-demo else cc-key 97 - if0 aot-demo else cc-key 98 - if0 compiler-bootstrap else cc-key 114 - if0 rl-main home-draw else cc-key 104 - if0 console-help else cc-key 112 - if0 1/3 1/6 + . else cc-key 115 - if0 "proof.frac" fs-source vc-type vc-newline else cc-key 103 - if0 "GRAPHICS IN FRANC" vc-type vc-newline 10 160 14 vc-pixel else cc-key 108 - if0 apps-load home-draw else cc-key 49 - if cc-key 58 - if cc-key home-app home-draw else "UNKNOWN KEY (h for help)" vc-type vc-newline then else "UNKNOWN KEY (h for help)" vc-type vc-newline then then then then then then then then then then then then then then then then then then then then then then then then again ;
def compiler-bootstrap "SELFHOST START" type cr "GEN 2: " type s2-self-source s2-source . "GEN 3: " type s2-self-source s2-source . "6 7 *" s2-compile s2-run . "SELFHOST OK" type cr ;
def compiler-probe "JIT-SUM " type "2 3 +" s2-compile s2-run . "JIT-DEF " type "def generated dup * ;" s2-compile drop "6 generated" s2-compile s2-run . ;
def boot dk-init vc-init "FRANC FRAMEBUFFER READY" vc-type vc-newline banner add-test 5 square . branch-test loop-test draw-demo ata-check store-check compiler-probe upgrade-load drop "AOT BOOT OK" vc-type vc-newline console-main ;
