\ AOT kernel proof: source is Franc; every runtime helper is assembly, not C.
\ The first standalone boot uses the existing Stage 1 BIOS loader.
def banner "FrancOS AOT | 64-bit | no C runtime" type cr ;
def add-test 1/3 1/6 + . ;
def square dup * ;
def branch-test 0 if0 "BRANCH OK" type cr else "BRANCH FAILED" type cr then ;
def loop-test 0 :count begin count 3 - while count 1 + :count repeat count . ;
def draw-demo 0 clearfb 10 20 14 pixel 11 20 15 pixel ;
def hardware? 1 ;
\ ATA driver below is stage3/ata.frac, compiled by the C-free AOT target.
\ Host-only fallbacks are never called by this standalone hardware kernel.
def disk-ready? 0 ;
def disk-format 0 ;
def host-save drop drop 0 ;
def host-source drop 0 ;
def host-files 0 drop ;
def store-check "proof.frac" "def saved 77 ;" fs-save . "proof.frac" fs-source type cr "STORAGE OK" type cr ;
def ata-check 128 ata-read-sector if0 "ATA READ FAILED" type cr exit then 0 sector-byte@ . 0 42 sector-byte! 190 ata-write-sector . 0 0 sector-byte! 190 ata-read-sector . 0 sector-byte@ . "ATA WRITE READBACK DONE" type cr ;
def boot banner add-test 5 square . branch-test loop-test draw-demo ata-check store-check "AOT BOOT OK" type cr ;
