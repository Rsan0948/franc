\ AOT kernel proof: source is Franc; every runtime helper is assembly, not C.
\ The first standalone boot uses the existing Stage 1 BIOS loader.
def banner "FrancOS AOT | 64-bit | no C runtime" type cr ;
def add-test 1/3 1/6 + . ;
def square dup * ;
def branch-test 0 if0 "BRANCH OK" type cr else "BRANCH FAILED" type cr then ;
def loop-test 0 :count begin count 3 - while count 1 + :count repeat count . ;
def draw-demo 0 clearfb 10 20 14 pixel 11 20 15 pixel ;
def hardware? 1 ;
\ ATA driver below is stage3/ata.frac, compiled by the C-free AOT target.
\ Host-only fallbacks are never called by this standalone hardware kernel.
def disk-ready? 0 ;
def disk-format 0 ;
def host-save drop drop 0 ;
def host-source drop 0 ;
def host-files 0 drop ;
def host-key 0 ;
def store-check "proof.frac" "def saved 77 ;" fs-save . "proof.frac" fs-source :sc-ptr sc-ptr if0 "STORAGE LOAD FAILED" type cr else sc-ptr type cr "STORAGE OK" type cr then ;
def ata-check 128 ata-read-sector if0 "ATA READ FAILED" type cr exit then 0 sector-byte@ . 0 42 sector-byte! 190 ata-write-sector . 0 0 sector-byte! 190 ata-read-sector . 0 sector-byte@ . "ATA WRITE READBACK DONE" type cr ;
\ Native keyboard loop: Franc owns the serial/PS2 input semantics and menu.
def console-help "h help  p rational  s storage  g graphics  r repl  b selfhost  a aot  c compile  d control  e strings  Esc exits" vc-type vc-newline ;
def console-main "FRANC INTERACTIVE READY" vc-type vc-newline console-help begin "Franc> " vc-type dk-key :cc-key cc-key 27 - if0 "EXIT CONSOLE" vc-type vc-newline exit then cc-key 101 - if0 aot-string-reg-demo else cc-key 100 - if0 aot-control-demo else cc-key 99 - if0 aot-program-demo else cc-key 97 - if0 aot-demo else cc-key 98 - if0 compiler-bootstrap else cc-key 114 - if0 rl-main else cc-key 104 - if0 console-help else cc-key 112 - if0 1/3 1/6 + . else cc-key 115 - if0 "proof.frac" fs-source vc-type vc-newline else cc-key 103 - if0 "GRAPHICS IN FRANC" vc-type vc-newline 10 160 14 vc-pixel else "?" vc-type vc-newline then then then then then then then then then then again ;
def compiler-bootstrap "SELFHOST START" type cr "GEN 2: " type s2-self-source s2-source . "GEN 3: " type s2-self-source s2-source . "6 7 *" s2-compile s2-run . "SELFHOST OK" type cr ;
def compiler-probe "JIT-SUM " type "2 3 +" s2-compile s2-run . "JIT-DEF " type "def generated dup * ;" s2-compile drop "6 generated" s2-compile s2-run . ;
def boot dk-init vc-init "FRANC FRAMEBUFFER READY" vc-type vc-newline banner add-test 5 square . branch-test loop-test draw-demo ata-check store-check compiler-probe upgrade-load drop "AOT BOOT OK" vc-type vc-newline console-main ;
