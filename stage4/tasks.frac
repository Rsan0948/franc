def task-step task-count if0 0 exit then task-base task-turn 8 * + s2-read64 :task-entry task-entry ifnz task-entry s2-run then task-turn 1 + task-count % :task-turn task-ticks 1 + :task-ticks 1 ;
def task-run-for :task-steps task-steps 0 - if 0 exit then task-steps 10001 - if0 0 exit then 0 :task-done begin task-done task-steps - while task-step if0 task-done exit then task-done 1 + :task-done repeat task-done ;
