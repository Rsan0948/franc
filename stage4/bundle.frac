\ Load a Franc source bundle staged with GNU dd at disk LBA 257 onward.
\ The source buffer is fixed RAM 0x200000..0x21ffff, beneath JIT code.
\ Trust boundary: never execute or compile untrusted source bundles.
\ Signature protects normal 256-sector images from accidental source scanning.
def bundle-source 512 ata-read-sector if0 0 exit then 0 sector-byte@ 70 - ifnz 0 exit then 1 sector-byte@ 82 - ifnz 0 exit then 2 sector-byte@ 65 - ifnz 0 exit then 3 sector-byte@ 78 - ifnz 0 exit then 4 sector-byte@ 67 - ifnz 0 exit then 5 sector-byte@ 83 - ifnz 0 exit then 6 sector-byte@ 82 - ifnz 0 exit then 7 sector-byte@ 67 - ifnz 0 exit then 0 :bs-count 513 :bs-lba begin bs-lba 769 - while bs-lba ata-read-sector if0 0 exit then 0 :bs-index begin bs-index 512 - while bs-count 131071 - if0 0 exit then bs-index sector-byte@ :bs-byte aot-bundle-area bs-count + bs-byte b! bs-byte if0 aot-bundle-area exit then bs-count 1 + :bs-count bs-index 1 + :bs-index repeat bs-lba 1 + :bs-lba repeat 0 ;
\ A complete source stream is emitted through Franc's own AOT compiler.
def bundle-demo bundle-source :bd-source bd-source if0 "FRANC-SOURCE-ERROR" type cr exit then bd-source aot-program drop "FRANC-SOURCE-END" type cr ;

def bundle-kernel bundle-source :bk-source bk-source if0 "FRANC-KERNEL-SOURCE-ERROR" type cr exit then bk-source aot-kernel-from-source drop "FRANC-KERNEL-END" type cr ;

\ Trusted native library source bundle (LBA 1024 marker; source at 1025).
\ Separate from the full kernel source pack (LBA 512) and FRANCFS1 (128).
def bundle-app-source 1024 ata-read-sector if0 0 exit then 0 sector-byte@ 70 - ifnz 0 exit then 1 sector-byte@ 82 - ifnz 0 exit then 2 sector-byte@ 65 - ifnz 0 exit then 3 sector-byte@ 78 - ifnz 0 exit then 4 sector-byte@ 67 - ifnz 0 exit then 5 sector-byte@ 83 - ifnz 0 exit then 6 sector-byte@ 82 - ifnz 0 exit then 7 sector-byte@ 67 - ifnz 0 exit then 0 :bs-count 1025 :bs-lba begin bs-lba 1281 - while bs-lba ata-read-sector if0 0 exit then 0 :bs-index begin bs-index 512 - while bs-count 131071 - if0 0 exit then bs-index sector-byte@ :bs-byte aot-bundle-area bs-count + bs-byte b! bs-byte if0 aot-bundle-area exit then bs-count 1 + :bs-count bs-index 1 + :bs-index repeat bs-lba 1 + :bs-lba repeat 0 ;
def apps-run :ar-name ar-name s2-find :ar-code ar-code if0 "APP NOT LOADED" type cr exit then ar-code s2-run ;
def apps-load bundle-app-source :al-source al-source if0 "APPS SOURCE MISSING" type cr exit then al-source s2-source :al-count "APPS LOADED " type al-count . "apps-init" s2-find :al-init al-init if0 "APPS INIT MISSING" type cr exit then al-init s2-run "APPS READY" type cr ;
def apps-menu :am-key am-key 49 - if0 "calc-main" apps-run exit then am-key 50 - if0 "app-edit" apps-run exit then am-key 51 - if0 "walk-main" apps-run exit then am-key 52 - if0 "app-font-demo" apps-run exit then am-key 53 - if0 "app-ford-demo" apps-run exit then am-key 54 - if0 "app-spiro-demo" apps-run exit then am-key 55 - if0 "math-demo" apps-run exit then am-key 56 - if0 "app-demo" apps-run exit then am-key 57 - if0 "ide-main" apps-run exit then "?" type cr ;
