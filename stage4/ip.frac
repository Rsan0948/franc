\ Franc-native bounded IPv4 and ICMP for QEMU SLIRP (10.0.2.15 -> 10.0.2.2).
\ Requires the e1000 MMIO driver and a successfully validated gateway ARP reply.
\ No IPv4 fragments/options, DHCP, DNS, UDP, TCP or raw user sockets yet.
\ Network byte order, strict 20-byte IPv4 headers, one ICMP echo payload.
def ip-u16! :ip-w-value :ip-w-addr ip-w-addr ip-w-value 256 / floor 255 band b! ip-w-addr 1 + ip-w-value 255 band b! ;
def ip-u16@ :ip-r-addr ip-r-addr b@ 256 * ip-r-addr 1 + b@ + ;
\ Standard ones-complement checksum, for even-length bounded packet data.
def ip-checksum :ip-c-size :ip-c-base ip-c-size 1 band ifnz 0 exit then 0 :ip-c-sum 0 :ip-c-i begin ip-c-i ip-c-size - while ip-c-base ip-c-i + b@ 256 * ip-c-base ip-c-i 1 + + b@ + ip-c-sum + :ip-c-sum ip-c-i 2 + :ip-c-i repeat begin ip-c-sum 65536 - if 65535 ip-c-sum - exit else ip-c-sum 65536 % ip-c-sum 65536 / floor + :ip-c-sum then again ;
\ Ethernet header: learned gateway destination and actual NIC source.
def ip-ether net-gw-ready if0 0 exit then 0 :ip-i begin ip-i 6 - while net-frame ip-i + net-gw-mac ip-i + b@ b! ip-i 4 - if net-maclo ip-i 8 * shr else net-machi ip-i 4 - 8 * shr then 255 band :ip-oct net-frame ip-i 6 + + ip-oct b! ip-i 1 + :ip-i repeat net-frame 12 + 8 b! net-frame 13 + 0 b! 1 ;
\ 20-byte IPv4 header, payload length <= 1480, TTL=64, DF=1.
\ Requires net-frame already zeroed and populated Ethernet header.
def ip-header :ip-proto :ip-payload ip-payload 0 - if 0 exit then ip-payload 1481 - if 1 else 0 then if0 0 exit then net-frame 14 + 69 b! net-frame 15 + 0 b! net-frame 16 + ip-payload 20 + ip-u16! net-frame 18 + 1 ip-u16! net-frame 20 + 16384 ip-u16! net-frame 22 + 64 b! net-frame 23 + ip-proto b! net-frame 24 + 0 ip-u16! net-frame 26 + 10 b! net-frame 27 + 0 b! net-frame 28 + 2 b! net-frame 29 + 15 b! net-frame 30 + 10 b! net-frame 31 + 0 b! net-frame 32 + 2 b! net-frame 33 + 2 b! net-frame 24 + net-frame 14 + 20 ip-checksum ip-u16! 1 ;
\ Send ICMP echo id=0x1234 seq=1, payload ASCII "FRANCOS!".
def ip-ping net-active if0 0 exit then net-gw-ready if0 0 exit then net-frame 60 net-zero ip-ether if0 0 exit then 16 1 ip-header if0 0 exit then net-frame 34 + 8 b! net-frame 35 + 0 b! net-frame 36 + 0 ip-u16! net-frame 38 + 4660 ip-u16! net-frame 40 + 1 ip-u16! net-frame 42 + 70 b! net-frame 43 + 82 b! net-frame 44 + 65 b! net-frame 45 + 78 b! net-frame 46 + 67 b! net-frame 47 + 79 b! net-frame 48 + 83 b! net-frame 49 + 33 b! net-frame 36 + net-frame 34 + 16 ip-checksum ip-u16! net-frame 60 net-tx ;
\ Reject bad ethertype, corrupt IPv4 checksum, fragments, wrong addresses.
def ip-rx-valid? net-rx-ready? if0 0 exit then net-rx-err ifnz 0 exit then net-rx-size 42 - if 0 exit then net-rx-ethertype 2048 - ifnz 0 exit then net-rx-ptr 14 + b@ 69 - ifnz 0 exit then net-rx-ptr 16 + ip-u16@ :ip-len ip-len 20 - if 0 exit then net-rx-size 14 - ip-len - if 0 exit then net-rx-ptr 20 + ip-u16@ 16383 band ifnz 0 exit then net-rx-ptr 14 + 20 ip-checksum ifnz 0 exit then net-rx-ptr 30 + b@ 10 - ifnz 0 exit then net-rx-ptr 31 + b@ ifnz 0 exit then net-rx-ptr 32 + b@ 2 - ifnz 0 exit then net-rx-ptr 33 + b@ 15 - ifnz 0 exit then 1 ;
\ Validates actual ICMP echo reply from 10.0.2.2, checksum, id/seq.
def ip-icmp-reply? ip-rx-valid? if0 0 exit then net-rx-ptr 23 + b@ 1 - ifnz 0 exit then net-rx-ptr 26 + b@ 10 - ifnz 0 exit then net-rx-ptr 27 + b@ ifnz 0 exit then net-rx-ptr 28 + b@ 2 - ifnz 0 exit then net-rx-ptr 29 + b@ 2 - ifnz 0 exit then ip-len 36 - if 0 exit then net-rx-ptr 34 + b@ ifnz 0 exit then net-rx-ptr 35 + b@ ifnz 0 exit then net-rx-ptr 38 + ip-u16@ 4660 - ifnz 0 exit then net-rx-ptr 40 + ip-u16@ 1 - ifnz 0 exit then net-rx-ptr 34 + ip-len 20 - ip-checksum ifnz 0 exit then 1 ;
