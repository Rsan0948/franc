\ Native Intel 82540EM (QEMU e1000) reusable polled TX/RX DMA rings.
\ Strictly trusted kernel-only. Uses 128MiB identity RAM and single rings.
\ Legacy e1000 PCI I/O BAR1 has stub QEMU handlers: use 32-bit PCI BAR0 MMIO.
\ BAR0 relocated to 0x08000000, outside guest RAM, within 256MiB identity map.
\ Scratch: TX descriptors 0x06c00000, RX desc 0x06c00200,
\ TX frame 0x06c01000, RX frames 0x06c04000..0x06c07fff.
\ 8 reusable TX and RX descriptors, synchronous send and explicit RX release.
\ Polling only; no IRQ, IPv4, TCP, UDP or concurrency.
def net-txdesc $6c00000 ;
def net-rxdesc $6c00200 ;
def net-frame $6c01000 ;
def net-rxframe $6c04000 ;
def net-gw-mac $6c08000 ;
def net-reg@ :net-reg net-mmio net-reg + mmio32@ ;
def net-reg! :net-value :net-reg net-mmio net-reg + net-value mmio32! ;
\ Add I/O-space and bus-master enables without clearing PCI status.
def net-enable-pci 0 net-slot 0 4 pci-read 65535 band :net-pcicmd net-pcicmd 2 band if0 net-pcicmd 2 + :net-pcicmd then net-pcicmd 4 band if0 net-pcicmd 4 + :net-pcicmd then 2147483648 net-slot 2048 * + 4 + $CF8 swap io32! $CFC net-pcicmd io32! ;

def net-zero :net-size :net-ptr 0 :net-i begin net-i net-size - while net-ptr net-i + 0 b! net-i 1 + :net-i repeat ;
def net-init pci-find-e1000 :net-slot net-slot 0 - if 0 exit then 0 net-slot 0 16 pci-read :net-bar net-bar 1 band ifnz 0 exit then 2147483648 net-slot 2048 * + 16 + $CF8 swap io32! $CFC 134217728 io32! 0 net-slot 0 16 pci-read 4294967280 band 134217728 - ifnz 0 exit then 134217728 :net-mmio net-enable-pci $d8 4294967295 net-reg! net-txdesc 128 net-zero net-rxdesc 128 net-zero net-frame 2048 net-zero net-rxframe 16384 net-zero net-gw-mac 16 net-zero 0 :net-gw-ready 0 :net-txnext 0 :net-rxnext 0 :net-received 0 :net-sent 0 :net-i begin net-i 8 - while net-rxdesc net-i 16 * + net-rxframe net-i 2048 * + s2-write64 net-i 1 + :net-i repeat $2800 net-rxdesc net-reg! $2804 0 net-reg! $2808 128 net-reg! $2810 0 net-reg! $2818 7 net-reg! $100 67141634 net-reg! net-txdesc net-frame s2-write64 $3800 net-txdesc net-reg! $3804 0 net-reg! $3808 128 net-reg! $3810 0 net-reg! $3818 0 net-reg! $410 6305802 net-reg! $400 262410 net-reg! $5400 net-reg@ :net-maclo $5404 net-reg@ :net-machi 1 :net-active 1 ;
\ Polling TX: descriptor index is advanced modulo eight after each send.
\ A single 2 KiB frame buffer is shared and used only after completion.
\ net-tx (pointer length -- success), 0 on invalid length or timeout.
def net-tx :net-len :net-src net-active if0 0 exit then net-len 14 - if 0 exit then net-len 1515 - if 1 else 0 then if0 0 exit then 0 :net-i begin net-i net-len - while net-frame net-i + net-src net-i + byte@ b! net-i 1 + :net-i repeat net-txdesc net-txnext 16 * + :net-txslot net-txslot net-frame s2-write64 net-txslot 8 + net-len 256 % b! net-txslot 9 + net-len 256 / floor b! net-txslot 10 + 0 b! net-txslot 11 + 11 b! net-txslot 12 + 0 b! net-txslot 13 + 0 b! net-txnext 1 + 8 % :net-txnext $3818 net-txnext net-reg! 0 :net-i begin net-i 200000 - while net-txslot 12 + b@ 1 band ifnz net-sent 1 + :net-sent 1 exit then net-i 1 + :net-i repeat 0 ;
\ Ethernet broadcast ARP WHO-HAS 10.0.2.2 from 10.0.2.15.
def net-arp-request net-active if0 0 exit then net-frame 60 net-zero 0 :net-i begin net-i 6 - while net-frame net-i + 255 b! net-i 6 + :net-j net-i 4 - if net-maclo net-i 8 * shr else net-machi net-i 4 - 8 * shr then 255 band :net-oct net-frame net-j + net-oct b! net-frame 22 net-i + + net-oct b! net-i 1 + :net-i repeat net-frame 12 + 8 b! net-frame 13 + 6 b! net-frame 14 + 0 b! net-frame 15 + 1 b! net-frame 16 + 8 b! net-frame 17 + 0 b! net-frame 18 + 6 b! net-frame 19 + 4 b! net-frame 20 + 0 b! net-frame 21 + 1 b! net-frame 28 + 10 b! net-frame 29 + 0 b! net-frame 30 + 2 b! net-frame 31 + 15 b! net-frame 38 + 10 b! net-frame 39 + 0 b! net-frame 40 + 2 b! net-frame 41 + 2 b! net-frame 60 net-tx ;
\ RX has eight 2048-byte buffers; do not rearm before consuming data.
def net-rx-slot net-rxdesc net-rxnext 16 * + ;
def net-rx-ptr net-rxframe net-rxnext 2048 * + ;
def net-rx-ready? net-active if0 0 exit then net-rx-slot 12 + b@ 1 band ;
def net-rx-size net-rx-slot 8 + b@ net-rx-slot 9 + b@ 256 * + ;
def net-rx-err net-rx-slot 13 + b@ ;
def net-rx-ethertype net-rx-ready? if0 0 exit then net-rx-ptr 12 + b@ 256 * net-rx-ptr 13 + b@ + ;
\ Release ownership back to NIC via RDT = previous head, then advance.
def net-rx-consume net-rx-ready? if0 0 exit then net-rx-slot 8 + 0 b! net-rx-slot 9 + 0 b! net-rx-slot 12 + 0 b! net-rx-slot 13 + 0 b! $2818 net-rxnext net-reg! net-rxnext 1 + 8 % :net-rxnext net-received 1 + :net-received 1 ;
\ Only accept the expected 10.0.2.2 ARP reply for our 10.0.2.15 IP.
def net-arp-reply? net-rx-ready? if0 0 exit then net-rx-err ifnz 0 exit then net-rx-size 42 - if 0 exit then net-rx-ethertype 2054 - ifnz 0 exit then net-rx-ptr 20 + b@ ifnz 0 exit then net-rx-ptr 21 + b@ 2 - ifnz 0 exit then net-rx-ptr 28 + b@ 10 - ifnz 0 exit then net-rx-ptr 29 + b@ ifnz 0 exit then net-rx-ptr 30 + b@ 2 - ifnz 0 exit then net-rx-ptr 31 + b@ 2 - ifnz 0 exit then net-rx-ptr 38 + b@ 10 - ifnz 0 exit then net-rx-ptr 39 + b@ ifnz 0 exit then net-rx-ptr 40 + b@ 2 - ifnz 0 exit then net-rx-ptr 41 + b@ 15 - ifnz 0 exit then 1 ;
def net-arp-learn net-arp-reply? if0 0 exit then 0 :net-i begin net-i 6 - while net-gw-mac net-i + net-rx-ptr 22 + net-i + b@ b! net-i 1 + :net-i repeat 1 :net-gw-ready 1 ;
