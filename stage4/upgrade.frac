\ Persistent Franc startup module; compiled and executed after cold BIOS boot.
\ Only a freshly compiled startup-main can run; stale dictionary entries are refused.
def upgrade-load "startup.frac" fs-source :ug-source ug-source if0 0 exit then "startup-main" s2-find :ug-before ug-source s2-source drop "startup-main" s2-find :ug-after ug-after if0 0 exit then ug-after ug-before - if0 0 exit then ug-after s2-run 1 ;
